---
import ProgramRow from './ProgramRow.astro';
import { filterStaseraPrograms, splitStaseraPrograms, toRomeMinutes } from '../utils/timeSlots';
import type { Program, Channel } from '../types';

interface Props {
  programs: Program[];
  channel?: Channel;
  showChannel?: boolean;
  filterCategory?: string;
  mode?: 'stasera' | 'domani' | 'full';
}

const { programs, channel, showChannel = false, filterCategory, mode = 'stasera' } = Astro.props;

const MORNING_START = 6 * 60;   // 06:00 Roma
const NOON = 12 * 60;           // 12:00 Roma
const PRIME_START = 20 * 60 + 30; // 20:30 Roma

const filtered = filterCategory
  ? programs.filter(p => p.category?.toLowerCase().includes(filterCategory.toLowerCase()))
  : programs;

let primeTime: Program[] = [];
let secondaSerata: Program[] = [];
let mattina: Program[] = [];
let pomeriggio: Program[] = [];
let beforePrimeTime: Program[] = [];
let afterPrimeTime: Program[] = [];
let fullDayCount = 0;

if (mode === 'stasera') {
  const staseraPrograms = filterStaseraPrograms(filtered);
  ({ primeTime, secondaSerata } = splitStaseraPrograms(staseraPrograms));
} else if (mode === 'domani') {
  const base = filtered.filter(p => toRomeMinutes(p.startTime) >= MORNING_START);
  mattina = base.filter(p => {
    const minutes = toRomeMinutes(p.startTime);
    return minutes >= MORNING_START && minutes < NOON;
  });
  pomeriggio = base.filter(p => {
    const minutes = toRomeMinutes(p.startTime);
    return minutes >= NOON && minutes < PRIME_START;
  });
  primeTime = base.filter(p => {
    const minutes = toRomeMinutes(p.startTime);
    return minutes >= PRIME_START && minutes < 23 * 60;
  });
  secondaSerata = base.filter(p => toRomeMinutes(p.startTime) >= 23 * 60);
} else {
  const base = filtered;
  fullDayCount = base.length;
  primeTime = base.filter(p => {
    const start = toRomeMinutes(p.startTime);
    const end = toRomeMinutes(p.endTime);
    return end > PRIME_START && start < 23 * 60;
  });
  beforePrimeTime = base.filter(p => toRomeMinutes(p.startTime) < PRIME_START);
  afterPrimeTime = base.filter(p => toRomeMinutes(p.startTime) >= 23 * 60);
}

const hasPrograms = mode === 'stasera'
  ? primeTime.length + secondaSerata.length > 0
  : mode === 'domani'
    ? mattina.length + pomeriggio.length + primeTime.length + secondaSerata.length > 0
    : fullDayCount > 0;

const channelName = channel?.name;
---

{!hasPrograms ? (
  <p class="text-slate-400 dark:text-slate-500 text-sm py-8 text-center">Nessun programma disponibile.</p>
) : (
  <div>
    {primeTime.length > 0 && (
      <section aria-label="Prime time">
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-orange-600 dark:text-orange-400 px-4 py-2 bg-orange-50 dark:bg-orange-900/20 border-b border-orange-100 dark:border-orange-800/30 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-orange-500 rounded-full inline-block"></span>
          {mode === 'stasera' ? 'Stasera · dalle 20:30' : 'Prime Time · dalle 20:30'}
        </h3>
        <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
          {primeTime.map(program => <ProgramRow {program} showChannel={showChannel ? channelName : undefined} channelId={channel?.id} channelLogo={channel?.logo} channelName={channel?.name} />)}
        </ul>
      </section>
    )}

    {mode === 'domani' && mattina.length > 0 && (
      <section aria-label="Mattina">
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
          Mattina · 06:00 – 12:00
        </h3>
        <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
          {mattina.map(program => <ProgramRow {program} showChannel={showChannel ? channelName : undefined} channelId={channel?.id} channelLogo={channel?.logo} channelName={channel?.name} />)}
        </ul>
      </section>
    )}

    {mode === 'domani' && pomeriggio.length > 0 && (
      <section aria-label="Pomeriggio">
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
          Pomeriggio · 12:00 – 20:30
        </h3>
        <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
          {pomeriggio.map(program => <ProgramRow {program} showChannel={showChannel ? channelName : undefined} channelId={channel?.id} channelLogo={channel?.logo} channelName={channel?.name} />)}
        </ul>
      </section>
    )}

    {mode === 'full' && beforePrimeTime.length > 0 && (
      <section aria-label="Pomeriggio e sera">
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
          Pomeriggio / Sera
        </h3>
        <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
          {beforePrimeTime.map(program => <ProgramRow {program} showChannel={showChannel ? channelName : undefined} channelId={channel?.id} channelLogo={channel?.logo} channelName={channel?.name} />)}
        </ul>
      </section>
    )}

    {(secondaSerata.length > 0 || afterPrimeTime.length > 0) && (
      <section aria-label="Seconda serata">
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
          Seconda serata · fino alle 02:00
        </h3>
        <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
          {(mode === 'full' ? afterPrimeTime : secondaSerata).map(program => <ProgramRow {program} showChannel={showChannel ? channelName : undefined} channelId={channel?.id} channelLogo={channel?.logo} channelName={channel?.name} />)}
        </ul>
      </section>
    )}
  </div>
)}
