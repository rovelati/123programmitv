---
import { localizeCategory, cleanDescription, formatImdbRating } from '../lib/format';
import { getProgramHeroImg } from '../lib/images';
import { getChannelStream } from '../utils/channelStreams';
import { getChannelLogo } from '../utils/channelLogos';

interface Props {
  program: {
    id: string;
    channel_id: string;
    channel_name: string;
    channel_logo: string;
    channel_number?: number;
    title: string;
    sub_title?: string;
    description?: string;
    category?: string;
    start_time: string;
    end_time: string;
    poster_url?: string | null;
    backdrop_url?: string | null;
    rating?: number | string | null;
    next_title?: string;
    next_time?: string;
  };
  isLive?: boolean;
  slot?: 'live' | 'morning' | 'prime' | 'late' | string;
  initiallyHidden?: boolean;
  genre?: string;
}

const { program, isLive = true, slot = 'live', initiallyHidden = false, genre } = Astro.props;

// Formatting times in Rome timezone
const formatTime = (iso: string) => {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Rome' });
};

const startTimeStr = formatTime(program.start_time);
const endTimeStr = formatTime(program.end_time);

// Calculate elapsed percentage
const startMs = new Date(program.start_time).getTime();
const endMs = new Date(program.end_time).getTime();
const nowMs = Date.now();
const durationMs = Math.max(1, endMs - startMs);
const elapsedPercent = Math.min(100, Math.max(0, Math.round(((nowMs - startMs) / durationMs) * 100)));
const remainingMins = Math.max(0, Math.round((endMs - nowMs) / 60000));

// Category normalization for client-side filtering
const titleLower = (program.title || '').toLowerCase().trim();
const catLower = (program.category || '').toLowerCase().trim();
const descLower = (program.description || '').toLowerCase().trim();
const allText = `${titleLower} ${catLower} ${descLower}`;

let normCat = 'general';
if (catLower.includes('film') || catLower.includes('cinema') || catLower.includes('commedia') || catLower.includes('thriller') || catLower.includes('drammatico') || catLower.includes('spielfilm')) {
  normCat = 'film';
} else if (allText.includes('doc') || allText.includes('documentario') || allText.includes('documentari') || allText.includes('cultura') || allText.includes('natura') || allText.includes('storia') || allText.includes('viaggi') || allText.includes('emozioni dal mondo')) {
  normCat = 'dok';
} else if (catLower.includes('serie') || catLower.includes('fiction') || catLower.includes('sitcom') || catLower.includes('soap') || catLower.includes('telenovela')) {
  normCat = 'serie';
} else if (catLower.includes('sport') || catLower.includes('calcio') || catLower.includes('tennis') || catLower.includes('motori') || catLower.includes('basket')) {
  normCat = 'sport';
} else if (catLower.includes('notizie') || catLower.includes('tg') || catLower.includes('telegiornale') || catLower.includes('informazione') || catLower.includes('attualità') || catLower.includes('meteo') || catLower.includes('nachrichten')) {
  normCat = 'news';
}

const channelPageUrl = `/${program.channel_id}/`;
const displayCategory = localizeCategory(program.category);
const cleanDesc = cleanDescription(program.description);
const ratingFormatted = formatImdbRating(program.rating, program.title, program.category);

// Official Streaming Link
const streamData = getChannelStream(program.channel_id);
const streamUrl = streamData?.url || `https://www.google.com/search?q=${encodeURIComponent('diretta streaming ' + program.channel_name)}`;
const streamLabel = streamData?.label || program.channel_name;
const streamOfficialTooltip = `Vedi streaming su sito ufficiale di ${program.channel_name}`;
const heroImage = getProgramHeroImg(program);
const channelLogo = getChannelLogo(program.channel_id, program.channel_logo);
---

<article
  class={`snap-item w-full py-2.5 sm:py-3 outline-none focus:ring-2 focus:ring-[#DA291C]/50 rounded-2xl ${initiallyHidden ? 'hidden' : ''}`}
  data-category={normCat}
  data-raw-category={catLower}
  data-genre={genre || normCat}
  data-slot={slot}
  data-start={program.start_time}
  tabindex="-1"
>
  <div class="max-w-6xl mx-auto bg-[#111827]/90 border border-gray-800/90 rounded-2xl overflow-hidden shadow-2xl hover:border-gray-700/80 transition-all duration-300">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
      
      <!-- Left Column: 16:9 Immersive Image with Overlay Play Button -->
      <div class="relative lg:col-span-7 aspect-video bg-black/60 overflow-hidden group">
        <img
          src={heroImage}
          alt={program.title}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1594909122845-11baa439b7bf?auto=format&fit=crop&w=1280&q=80';"
        />

        <!-- Gradient Vignette -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#111827] via-transparent to-black/40"></div>

        <!-- Top Badges Overlay -->
        <div class="absolute top-3.5 left-3.5 right-3.5 sm:top-4 sm:left-4 sm:right-4 flex items-center justify-between gap-2 z-30">
          <!-- Channel Logo Link Pill -->
          <a
            href={channelPageUrl}
            class="flex items-center gap-2 bg-black/85 hover:bg-black/95 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/15 hover:border-red-500/60 shadow-lg group/ch transition-all max-w-[65%]"
            title={`Palinsesto ${program.channel_name}`}
          >
            {channelLogo ? (
              <span class="inline-flex items-center justify-center h-6 max-h-6 max-w-[80px] overflow-hidden shrink-0">
                <img
                  src={channelLogo}
                  alt={program.channel_name}
                  class="max-h-6 max-w-[80px] w-auto h-auto object-contain group-hover/ch:scale-105 transition-transform"
                  style="max-height: 24px; max-width: 80px; height: 24px; width: auto; object-fit: contain;"
                  onerror="this.style.display='none'"
                />
              </span>
            ) : (
              <span class="text-xs font-black text-white truncate">{program.channel_name}</span>
            )}
            {program.channel_number ? (
              <span class="text-[10px] font-bold text-gray-400 bg-gray-800/80 px-1.5 py-0.5 rounded shrink-0">
                CH {program.channel_number}
              </span>
            ) : null}
            <svg class="w-3 h-3 text-gray-400 group-hover/ch:text-red-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <!-- Live Indicator or Time Badge -->
          {isLive ? (
            <div class="flex items-center gap-1.5 bg-[#DA291C] text-white px-2.5 py-1 rounded-lg text-xs font-black shadow-lg animate-pulse">
              <span class="w-2 h-2 rounded-full bg-white"></span>
              IN ONDA ORA
            </div>
          ) : (
            <div class="bg-gray-900/90 text-white px-2.5 py-1 rounded-lg text-xs font-bold border border-white/10">
              {startTimeStr}
            </div>
          )}
        </div>

        <!-- Central Play Button Link (Opens direct stream on RaiPlay, Mediaset Infinity, etc.) -->
        <a
          href={streamUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute inset-0 flex flex-col items-center justify-center group/play z-20"
          aria-label={streamOfficialTooltip}
        >
          <div class="w-10 h-10 sm:w-16 sm:h-16 rounded-full bg-[#DA291C]/90 text-white flex items-center justify-center shadow-2xl shadow-red-900/50 group-hover/play:scale-110 group-hover/play:bg-[#DA291C] transition-all duration-300 border border-white/40 sm:border-2 backdrop-blur-sm">
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-white translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
          <!-- On mouse-over tooltip pill -->
          <div class="hidden sm:inline-flex items-center gap-1.5 mt-2 px-3 py-1 rounded-full bg-black/85 backdrop-blur-md text-white text-[11px] font-semibold border border-white/20 shadow-xl opacity-0 group-hover/play:opacity-100 transform translate-y-1 group-hover/play:translate-y-0 transition-all duration-200 pointer-events-none max-w-[90%] truncate">
            <span class="truncate">{streamOfficialTooltip}</span>
            <svg class="w-3 h-3 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
        </a>

        <!-- Bottom Timeline / Progress Bar on image -->
        <div class="absolute bottom-0 left-0 right-0 p-4 z-10">
          <div class="flex items-center justify-between text-xs text-white/90 font-medium mb-1.5 drop-shadow">
            <span>{startTimeStr} - {endTimeStr}</span>
            {isLive && <span class="live-remaining-text" data-start={startMs} data-end={endMs}>{remainingMins} min rimasti</span>}
          </div>
          {isLive && (
            <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden backdrop-blur-sm">
              <div class="live-progress-fill h-full bg-[#DA291C] rounded-full transition-all duration-500" data-start={startMs} data-end={endMs} style={`width: ${elapsedPercent}%`}></div>
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Programme Metadata & Action Controls -->
      <div class="lg:col-span-5 p-4 sm:p-5 flex flex-col justify-between bg-[#111827]">
        <div>
          
          <!-- Category & Rating Tags -->
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            {displayCategory && (
              <span class="text-[11px] font-bold uppercase tracking-wider text-red-400 bg-red-950/50 border border-red-800/40 px-2 py-0.5 rounded">
                {displayCategory}
              </span>
            )}

            <!-- Authentic IMDb / TMDb Rating Badge -->
            {ratingFormatted && (
              <a
                href={`https://www.google.com/search?q=${encodeURIComponent(program.title + ' film recensione voto')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-black bg-[#F5C518] hover:bg-yellow-400 text-black px-2 py-0.5 rounded shadow-sm transition-colors group/imdb"
                title={`Voto: ${ratingFormatted}/10`}
              >
                <span class="text-[10px] font-black tracking-tighter bg-black text-[#F5C518] px-1 py-0.2 rounded font-sans leading-none">Voto</span>
                <span class="font-black text-black">★ {ratingFormatted}</span>
              </a>
            )}

            <!-- Channel Schedule Link Pill -->
            <a
              href={channelPageUrl}
              class="text-[11px] font-bold text-gray-400 hover:text-white bg-gray-800/80 hover:bg-gray-700/80 border border-gray-700/60 px-2 py-0.5 rounded transition-colors flex items-center gap-1"
              title={`Palinsesto ${program.channel_name}`}
            >
              <span>{program.channel_name}</span>
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Main Title -->
          <h2 class="text-lg sm:text-xl font-black text-white tracking-tight leading-snug mb-2 hover:text-red-400 transition-colors line-clamp-2">
            <a href={channelPageUrl}>
              {program.title}
            </a>
          </h2>

          <!-- Description / Synopsis -->
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed line-clamp-2 sm:line-clamp-3 mb-3">
            {cleanDesc || 'Nessuna descrizione dettagliata disponibile.'}
          </p>
        </div>

        <div class="space-y-3 pt-2 border-t border-gray-800/60">
          
          <!-- Stream & Push Notification Actions -->
          <div class="flex items-center gap-2">
            <!-- Direct Stream Watch Button -->
            <a
              href={streamUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 bg-[#DA291C] hover:bg-red-700 text-white font-bold text-xs sm:text-sm py-2 px-3 rounded-xl shadow-lg shadow-red-900/30 hover:scale-[1.02] transition-all"
              title={streamOfficialTooltip}
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
              <span class="truncate">Guarda su {streamLabel}</span>
            </a>

            <!-- Push Notification Button -->
            <button
              type="button"
              class="push-remind-btn flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold text-xs py-2 px-3 rounded-xl border border-gray-700 transition-colors shrink-0 cursor-pointer"
              data-title={program.title}
              data-time={startTimeStr}
              data-channel={program.channel_name}
              title="Ricordamelo"
            >
              <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <span class="hidden sm:inline">Ricordamelo</span>
            </button>
          </div>

          <!-- Next Programme Sneak Peek -->
          {program.next_title && (
            <div class="flex items-center justify-between text-xs text-gray-400 bg-gray-900/70 p-2.5 rounded-xl border border-gray-800/60">
              <div class="flex items-center gap-2 truncate">
                <span class="text-gray-500 uppercase text-[10px] font-bold">A seguire:</span>
                <span class="text-gray-300 font-medium truncate">{program.next_title}</span>
              </div>
              <span class="text-red-400 font-bold ml-2 shrink-0">{program.next_time}</span>
            </div>
          )}
        </div>

      </div>

    </div>
  </div>
</article>
