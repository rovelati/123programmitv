---
import { sitePath } from '../utils/urls';

const CATEGORY_HUBS = [
  { href: sitePath('/film-stasera'),  label: 'Film stasera' },
  { href: sitePath('/serie-stasera'), label: 'Serie TV' },
  { href: sitePath('/uscite-serie-tv'), label: 'Uscite Serie TV' },
  { href: sitePath('/sport-stasera'), label: 'Sport' },
  { href: sitePath('/frequenze-dtt'), label: 'Frequenze DTT' },
];

const pathname = Astro.url.pathname;
const isStasera = pathname === '/' || pathname === '';
const isOra     = pathname.startsWith('/ora');
const isDomani  = pathname.startsWith('/domani');
---

<header class="bg-[#0B0F19]/95 backdrop-blur-md border-b border-gray-800/80 sticky top-0 z-50 shadow-lg">
  <div class="max-w-7xl mx-auto px-3 sm:px-6">
    <!-- Top bar -->
    <div class="flex items-center justify-between h-14 sm:h-16 gap-2 sm:gap-4">

      <!-- Logo con icona Rosso Ferrari -->
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 select-none group shrink-0" aria-label="inTV stasera - Home">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-[#DA291C] flex items-center justify-center shadow-lg shadow-red-900/40 group-hover:scale-105 transition-transform shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <div class="flex flex-col -space-y-1">
          <span class="text-sm sm:text-xl font-black tracking-tight text-white group-hover:text-red-400 transition-colors">
            inTV<span class="text-[#DA291C]">stasera.it</span>
          </span>
          <span class="text-[9px] text-gray-400 font-medium hidden sm:block">Guida TV & Live Streaming Italia</span>
        </div>
      </a>

      <!-- Nav desktop: Stasera | Ora | Domani | — | Film | Serie | Sport -->
      <nav class="hidden md:flex items-center gap-1.5 text-sm flex-1 justify-center" aria-label="Navigazione principale">
        <a href="/" class:list={['flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl font-bold transition-all text-xs lg:text-sm', isStasera ? 'bg-[#DA291C] text-white shadow-md shadow-red-900/30' : 'text-gray-300 hover:text-white hover:bg-gray-800/60']}>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          Stasera
        </a>
        <a href="/ora/" class:list={['flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl font-bold transition-all text-xs lg:text-sm', isOra ? 'bg-[#DA291C] text-white shadow-md shadow-red-900/30' : 'text-gray-300 hover:text-white hover:bg-gray-800/60']}>
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          In onda
        </a>
        <a href="/domani/" class:list={['px-3 py-1.5 rounded-xl font-semibold transition-all text-xs lg:text-sm', isDomani ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/60']}>
          Domani
        </a>
        <span class="w-px h-5 bg-gray-800 mx-1"></span>
        {CATEGORY_HUBS.map(cat => (
          <a href={cat.href} class="px-2.5 py-1.5 rounded-lg font-medium hover:bg-gray-800/60 hover:text-white transition-colors text-gray-400 text-xs">
            {cat.label}
          </a>
        ))}
      </nav>

      <!-- Destra: mobile tabs -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- Mobile: STASERA / IN ONDA / DOMANI -->
        <div class="flex md:hidden items-center gap-1 bg-gray-900 border border-gray-800 rounded-xl p-1">
          <a href="/" class:list={['px-2.5 py-1 rounded-lg text-[11px] font-black uppercase tracking-wide transition-all whitespace-nowrap', isStasera ? 'bg-[#DA291C] text-white shadow-sm' : 'text-gray-400 hover:text-white']}>STASERA</a>
          <a href="/ora/" class:list={['px-2.5 py-1 rounded-lg text-[11px] font-black uppercase tracking-wide transition-all whitespace-nowrap', isOra ? 'bg-[#DA291C] text-white shadow-sm' : 'text-gray-400 hover:text-white']}>IN ONDA</a>
          <a href="/domani/" class:list={['px-2 py-1 rounded-lg text-[11px] font-bold uppercase tracking-wide transition-all whitespace-nowrap', isDomani ? 'bg-[#DA291C] text-white shadow-sm' : 'text-gray-400 hover:text-white']}>DOM</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const sun  = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    if (!sun || !moon) return;
    sun.classList.toggle('hidden', !isDark);
    moon.classList.toggle('hidden', isDark);
  }

  function toggleTheme() {
    // Aggiunge classe transizione per animazione fluida
    document.documentElement.classList.add('theme-transition');
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons();
    // Rimuove classe transizione dopo l'animazione
    setTimeout(() => document.documentElement.classList.remove('theme-transition'), 300);
  }

  // Gli script Astro sono ES modules deferred: DOMContentLoaded è già scattato.
  // Chiamiamo direttamente senza alcun wrapper.
  updateIcons();
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
</script>
