---
const CATEGORY_HUBS = [
  { href: '/film-stasera',  label: 'Film stasera' },
  { href: '/serie-stasera', label: 'Serie TV' },
  { href: '/sport-stasera', label: 'Sport' },
];

const pathname = Astro.url.pathname;
const isOra     = pathname === '/';
const isStasera = pathname === '/stasera';
const isDomani  = pathname === '/domani';
---

<header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Top bar -->
    <div class="flex items-center justify-between h-16 gap-3">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 select-none group shrink-0" aria-label="In TV Stasera - Home">
        <div class="transition-all duration-300 group-hover:scale-105 group-hover:rotate-1">
          <img src="/favicon.svg" alt="In TV Stasera" class="w-[52px] h-[44px] drop-shadow-lg" />
        </div>
        <div class="hidden sm:flex flex-col -space-y-1.5">
          <span class="text-[10px] font-black tracking-[0.3em] text-blue-600 uppercase">Italia</span>
          <span class="text-xl font-light tracking-tighter text-slate-800 dark:text-slate-200">
            PROGRAMMI <span class="font-black text-slate-950 dark:text-white">TV</span>
          </span>
        </div>
      </a>

      <!-- Nav desktop: Ora | Stasera | Domani | — | Film | Serie | Sport -->
      <nav class="hidden md:flex items-center gap-1 text-sm flex-1 justify-center" aria-label="Navigazione principale">
        <a href="/" class:list={['px-3 py-1.5 rounded-lg font-semibold transition-colors', isOra ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800']}>Ora</a>
        <a href="/stasera" class:list={['px-3 py-1.5 rounded-lg font-semibold transition-colors', isStasera ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800']}>Stasera</a>
        <a href="/domani" class:list={['px-3 py-1.5 rounded-lg font-semibold transition-colors', isDomani ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800']}>Domani</a>
        <span class="w-px h-5 bg-slate-200 dark:bg-slate-700 mx-1"></span>
        {CATEGORY_HUBS.map(cat => (
          <a href={cat.href} class="px-3 py-1.5 rounded-lg font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-500 dark:text-slate-400 text-xs">
            {cat.label}
          </a>
        ))}
      </nav>

      <!-- Destra: mobile tabs + toggle tema -->
      <div class="flex items-center gap-2 shrink-0">

        <!-- Mobile: ORA / SERA / DOM -->
        <div class="flex md:hidden items-center gap-0.5 bg-slate-100 dark:bg-slate-800/95 dark:ring-1 dark:ring-slate-700 rounded-full p-1">
          <a href="/" class:list={['px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide transition-colors whitespace-nowrap', isOra ? 'bg-blue-600 text-white shadow-sm shadow-blue-950/30' : 'text-slate-600 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white']}>ORA</a>
          <a href="/stasera" class:list={['px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide transition-colors whitespace-nowrap', isStasera ? 'bg-blue-600 text-white shadow-sm shadow-blue-950/30' : 'text-slate-600 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white']}>SERA</a>
          <a href="/domani" class:list={['px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide transition-colors whitespace-nowrap', isDomani ? 'bg-blue-600 text-white shadow-sm shadow-blue-950/30' : 'text-slate-600 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white']}>DOM</a>
        </div>

        <!-- Toggle dark/light mode -->
        <button
          id="theme-toggle"
          aria-label="Cambia tema"
          class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-500 dark:text-slate-300 dark:hover:text-white"
        >
          <!-- Sole (visibile in dark mode → click per tornare al chiaro) -->
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <!-- Luna (visibile in light mode → click per dark) -->
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

      </div>
    </div>
  </div>
</header>

<script>
  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const sun  = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    if (!sun || !moon) return;
    sun.classList.toggle('hidden', !isDark);
    moon.classList.toggle('hidden', isDark);
  }

  function toggleTheme() {
    // Aggiunge classe transizione per animazione fluida
    document.documentElement.classList.add('theme-transition');
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons();
    // Rimuove classe transizione dopo l'animazione
    setTimeout(() => document.documentElement.classList.remove('theme-transition'), 300);
  }

  // Gli script Astro sono ES modules deferred: DOMContentLoaded è già scattato.
  // Chiamiamo direttamente senza alcun wrapper.
  updateIcons();
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
</script>
