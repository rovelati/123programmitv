---
import { HUB_CHANNELS } from '../utils/channelSlug';
import { sitePath } from '../utils/urls';
import type { Channel } from '../types';

interface Props {
  channels?: Channel[];
  currentChannelId?: string;
  title?: string;
  intro?: string;
  maxChannels?: number;
  compact?: boolean;
}

const {
  channels,
  currentChannelId,
  title = 'Guida TV: pagine principali',
  intro = 'Scopri rapidamente i programmi TV per fascia oraria, categoria e canale.',
  maxChannels = 36,
  compact = false,
} = Astro.props;

const seen = new Set<string>();
const channelLinks = (channels ?? HUB_CHANNELS)
  .filter(ch => {
    if (!ch.id || ch.id === currentChannelId || seen.has(ch.id)) return false;
    seen.add(ch.id);
    return true;
  })
  .slice(0, maxChannels);

const primaryLinks = [
  { href: sitePath('/'), label: 'inTV stasera' },
  { href: sitePath('/ora'), label: 'inTV ora' },
  { href: sitePath('/domani'), label: 'inTV domani' },
  { href: sitePath('/film-stasera'), label: 'Film in TV stasera' },
  { href: sitePath('/serie-stasera'), label: 'Serie TV stasera' },
  { href: sitePath('/sport-stasera'), label: 'Sport in TV stasera' },
];

const trendingChannels = [
  { href: sitePath('/inter-tv'), label: 'Inter TV' },
  { href: sitePath('/20'), label: 'Canale 20' },
  { href: sitePath('/la7d'), label: 'La7d' },
  { href: sitePath('/eurosport'), label: 'Eurosport' },
  { href: sitePath('/sky-sport-calcio'), label: 'Sky Sport Calcio' },
  { href: sitePath('/rai-2'), label: 'Rai 2' },
  { href: sitePath('/rai-3'), label: 'Rai 3' },
  { href: sitePath('/mediaset-27-twentyseven'), label: 'Canale 27' },
].filter(c => c.href !== sitePath(`/${currentChannelId}`));
---

<aside class:list={[
  'mt-8 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 p-4 sm:p-5 shadow-sm',
  compact && 'mt-6',
]} aria-labelledby="seo-hub-links-title">
  <h2 id="seo-hub-links-title" class="text-base sm:text-lg font-extrabold text-slate-900 dark:text-slate-100 mb-1">
    {title}
  </h2>
  {!compact && <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{intro}</p>}

  <nav aria-label="Guide TV principali" class:list={[compact ? 'mb-3' : 'mb-4']}>
    {!compact && (
      <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">
        Guide principali
      </h3>
    )}
    <div class="flex flex-wrap gap-2">
      {primaryLinks.map(link => (
        <a href={link.href} class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-700 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 text-slate-600 dark:text-slate-200 text-xs font-semibold transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </nav>

  {trendingChannels.length > 0 && (
    <nav aria-label="Canali in primo piano" class:list={[compact ? 'mb-3' : 'mb-4']}>
      {!compact && (
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">
          Canali in primo piano
        </h3>
      )}
      <div class="flex flex-wrap gap-2">
        {trendingChannels.map(item => (
          <a href={item.href} class="px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900/40 text-blue-700 dark:text-blue-300 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 text-xs font-semibold transition-colors">
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  )}

  {channelLinks.length > 0 && (
    <nav aria-label="Programmi TV per canale">
      {!compact && (
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">
          Programmi per canale
        </h3>
      )}
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {channelLinks.map(ch => (
          <a href={sitePath(`/${ch.id}`)} class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 hover:underline transition-colors">
            Programmi {ch.name} stasera
          </a>
        ))}
      </div>
    </nav>
  )}
</aside>
