---
import { HUB_CHANNELS } from '../utils/channelSlug';
import { sitePath } from '../utils/urls';

const CATEGORY_HUBS = [
  { href: sitePath('/film-stasera'),  label: 'Film stasera in TV' },
  { href: sitePath('/serie-stasera'), label: 'Serie TV stasera' },
  { href: sitePath('/uscite-serie-tv'), label: 'Uscite Serie TV & Countdown' },
  { href: sitePath('/sport-stasera'), label: 'Sport stasera in TV' },
  { href: sitePath('/domani'),        label: 'Programmi di domani' },
  { href: sitePath('/frequenze-dtt'), label: 'Frequenze DTT e Canali' },
];

const LEGAL_LINKS = [
  { href: sitePath('/privacy-policy'),    label: 'Privacy Policy' },
  { href: sitePath('/cookie-policy'),     label: 'Cookie Policy' },
  { href: sitePath('/termini-e-condizioni'), label: 'Termini e Condizioni' },
];

const INTERNATIONAL_SITES = [
  { name: 'ProgrammeCeSoir.fr', flag: '🇫🇷', url: 'https://programmecesoir.fr/' },
  { name: 'FernsehHeute.de', flag: '🇩🇪', url: 'https://fernsehheute.de/' },
  { name: 'UKTVTonight.co.uk', flag: '🇬🇧', url: 'https://uktvtonight.co.uk/' },
  { name: 'AussieTVTonight.com', flag: '🇦🇺', url: 'https://aussietvtonight.com/' },
  { name: 'TeleEstaNoche.es', flag: '🇪🇸', url: 'https://www.teleestanoche.es/' },
  { name: 'TVWieczor.pl', flag: '🇵🇱', url: 'https://tvwieczor.pl/' },
];
---

<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700 mt-12 text-sm text-slate-500 dark:text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <div class="mb-8">
      <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-3 text-xs uppercase tracking-wider">Canali TV</h2>
      <nav class="flex flex-wrap gap-2" aria-label="Guida TV per canale">
        {HUB_CHANNELS.map(ch => (
          <a href={sitePath(`/${ch.id}`)} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            Programmi {ch.name}
          </a>
        ))}
      </nav>
    </div>

    <div class="mb-8">
      <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-3 text-xs uppercase tracking-wider">Categorie</h2>
      <nav class="flex flex-wrap gap-4" aria-label="Programmi per categoria">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Programmi stasera in TV</a>
        {CATEGORY_HUBS.map(cat => (
          <a href={cat.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{cat.label}</a>
        ))}
      </nav>
    </div>

    <div class="mb-8 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-3 text-xs uppercase tracking-wider">Guida TV Internazionale</h2>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs" aria-label="Guida TV Internazionale">
        {INTERNATIONAL_SITES.map(site => (
          <a href={site.url} class="inline-flex items-center gap-1.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            <span>{site.flag}</span>
            <span>{site.name}</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="pt-6 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-slate-400 dark:text-slate-500">&copy; {new Date().getFullYear()} In TV Stasera &mdash; Guida TV italiana</p>
      <nav class="flex gap-4 text-xs" aria-label="Link legali">
        {LEGAL_LINKS.map(link => (
          <a href={link.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{link.label}</a>
        ))}
      </nav>
    </div>

  </div>
</footer>
