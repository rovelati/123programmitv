---
/**
 * Card canale.
 * mode = 'ora'     → JS client-side trova il programma live in tempo reale
 * mode = 'stasera' → server-side: prime time 20:30+ (statico, corretto)
 * mode = 'domani'  → server-side: prime time domani o primo dalle 06:00
 */
import { formatTime, isProgramLive, filterStaseraPrograms, toRomeMinutes } from '../utils/timeSlots';
import type { Channel, Program } from '../types';

interface Props {
  channel: Channel;
  programs: Program[];
  mode?: 'ora' | 'stasera' | 'domani';
}

const { channel, programs: rawPrograms, mode = 'stasera' } = Astro.props;

const programs = mode === 'stasera' ? filterStaseraPrograms(rawPrograms) : rawPrograms;

// ─── Soglie orarie (Europe/Rome) ───────────────────────────────────────────
const PRIME_START   = 20 * 60 + 30; // 20:30
const PRIME_END     = 23 * 60;       // 23:00
const MORNING_START = 6 * 60;        // 06:00
const EVENING_START = 18 * 60;       // 18:00

// ─── Selezione programma SERVER-SIDE (per stasera/domani) ─────────────────
const primeTimeProgram = programs.find(p => { const m = toRomeMinutes(p.startTime); return m >= PRIME_START && m < PRIME_END; }) ?? null;
const eveningProgram   = programs.find(p => toRomeMinutes(p.startTime) >= EVENING_START) ?? null;
const morningFirst     = programs.find(p => toRomeMinutes(p.startTime) >= MORNING_START) ?? null;

let displayProgram: Program | null = null;
if (mode === 'domani') {
  displayProgram = primeTimeProgram ?? morningFirst ?? programs[0] ?? null;
} else if (mode === 'stasera') {
  displayProgram = primeTimeProgram ?? eveningProgram ?? programs[0] ?? null;
}

// Per stasera/domani: prossimo programma
const nextProgram = displayProgram
  ? programs.find(p => new Date(p.startTime) > new Date(displayProgram!.endTime))
  : null;

// Per stasera/domani: progress bar sempre a 0 (programma futuro)
const progress = 0;

// ─── JSON per ORA mode (usato dal JS client-side) ─────────────────────────
// Include tutti i campi necessari per l'overlay
const programsJson = mode === 'ora'
  ? JSON.stringify(programs.map(p => ({
      id: p.id,
      title: p.title,
      startTime: p.startTime,
      endTime: p.endTime,
      category: p.category ?? '',
      description: p.description ?? '',
      poster_url: p.poster_url ?? null,
    })))
  : '[]';

// ─── JSON overlay per stasera/domani (server-side) ────────────────────────
const staseraOverlayJson = displayProgram
  ? JSON.stringify({
      id:          displayProgram.id,
      title:       displayProgram.title,
      startTime:   displayProgram.startTime,
      endTime:     displayProgram.endTime,
      category:    displayProgram.category   ?? '',
      description: displayProgram.description ?? '',
      poster_url:  displayProgram.poster_url  ?? null,
      channelId:   channel.id,
      channelLogo: channel.logo,
      channelName: channel.name,
    })
  : null;
---

<a
  href={`/${channel.id}`}
  class:list={[
    'block group border-b border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors',
    mode === 'ora' && 'ora-card',
  ]}
  data-channel-id={mode === 'ora' ? channel.id : undefined}
  data-channel-logo={mode === 'ora' ? channel.logo : undefined}
  data-channel-name={mode === 'ora' ? channel.name : undefined}
  aria-label={`Vai ai programmi ${channel.name}`}
>
  <div class="grid grid-cols-[72px_1fr] sm:grid-cols-[88px_1fr_20px] gap-3 px-3 py-3 sm:px-4 sm:py-3.5">

    <!-- Colonna sinistra: logo + nome + numero -->
    <div class="flex flex-col items-start gap-1.5">
      <div class="w-9 h-9 sm:w-10 sm:h-10 flex-shrink-0 flex items-center justify-center overflow-hidden rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 shadow-sm">
        <img
          src={channel.logo}
          alt={`Logo ${channel.name}`}
          width="36" height="36"
          class="w-full h-full object-contain"
          loading="lazy"
          onerror="this.style.display='none'"
        />
      </div>
      <div class="min-w-0 w-full">
        <p class="text-xs sm:text-sm font-extrabold text-slate-950 dark:text-slate-100 leading-tight truncate">{channel.name}</p>
        {channel.number > 0 && <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">CH {channel.number}</p>}
      </div>
    </div>

    <!-- Colonna destra: programma -->
    <div class="min-w-0 py-0.5">

      {/* ── MODE: ORA → placeholder, aggiornato da JS ── */}
      {mode === 'ora' && (
        <div class="ora-program-content" data-programs={programsJson}>
          <!-- Scheletro iniziale — JS lo sostituisce subito -->
          <div class="h-3 w-1/2 bg-slate-200 dark:bg-slate-700 rounded animate-pulse mb-1.5"></div>
          <div class="h-4 w-3/4 bg-slate-200 dark:bg-slate-700 rounded animate-pulse mb-3"></div>
          <div class="h-[3px] w-full bg-slate-200 dark:bg-slate-600 rounded-full mb-2"></div>
          <div class="h-3 w-2/3 bg-slate-100 dark:bg-slate-700/60 rounded animate-pulse"></div>
        </div>
      )}

      {/* ── MODE: STASERA / DOMANI → server-side ── */}
      {mode !== 'ora' && (
        <>
          {displayProgram ? (
            <div
              data-program={staseraOverlayJson}
              class="cursor-pointer"
              title="Clicca per i dettagli"
            >
              <div class="flex gap-2.5">
                {displayProgram.poster_url && (
                  <div class="w-10 h-14 sm:w-12 sm:h-16 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-700 flex-shrink-0 shadow-sm">
                    <img
                      src={displayProgram.poster_url}
                      alt={`Poster ${displayProgram.title}`}
                      width="48"
                      height="64"
                      class="w-full h-full object-cover"
                      loading="lazy"
                      onerror="this.closest('div').style.display='none'"
                    />
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <p class="text-[12px] text-slate-500 dark:text-slate-400 mb-0.5 flex items-center gap-1.5 flex-wrap">
                    <span class="tabular-nums font-medium">{formatTime(displayProgram.startTime)} – {formatTime(displayProgram.endTime)}</span>
                    {displayProgram.category && (
                      <span class="uppercase tracking-wide font-bold text-slate-500 dark:text-slate-400">{displayProgram.category}</span>
                    )}
                  </p>
                  <p class="text-[15px] sm:text-base font-extrabold text-slate-950 dark:text-slate-100 leading-snug mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                    {displayProgram.title}
                  </p>
                  {displayProgram.description && (
                    <p class="text-[13px] text-slate-600 dark:text-slate-300 leading-snug line-clamp-2 mb-2">
                      {displayProgram.description}
                    </p>
                  )}
                </div>
              </div>
              <div class="h-[3px] w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-600 mb-2">
                <div class="h-full rounded-full bg-slate-300 dark:bg-slate-500" style="width:0%"></div>
              </div>
              {nextProgram && (
                <p class="text-[12px] text-slate-500 dark:text-slate-400 truncate">
                  <span class="tabular-nums">{formatTime(nextProgram.startTime)}</span>{' — '}
                  <span class="text-slate-700 dark:text-slate-300">{nextProgram.title}</span>
                </p>
              )}
            </div>
          ) : (
            <p class="text-xs text-slate-400 dark:text-slate-500 italic">Nessun programma</p>
          )}
        </>
      )}
    </div>

    <!-- Chevron (solo desktop) -->
    <div class="hidden sm:flex items-center justify-center">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-slate-300 dark:text-slate-600 group-hover:text-blue-400 transition-colors">
        <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

  </div>
</a>

<script>
// ORA mode: JS client-side, usa Date.now() reale del browser.
// NOTA: gli script Astro sono ES modules deferred — il DOM è già pronto
// quando questo viene eseguito. NON usare DOMContentLoaded (già scattato).

function fmtTime(iso) {
  return new Date(iso).toLocaleTimeString('it-IT', {
    timeZone: 'Europe/Rome', hour: '2-digit', minute: '2-digit', hour12: false,
  });
}

function esc(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function buildCardHTML(prog, nextProg, isLive, isUpcoming, progress, programDataJson) {
  if (!prog) return '<p class="text-xs text-slate-400 dark:text-slate-500 italic">Nessun programma</p>';

  const liveBadge = isUpcoming
    ? `<span class="inline-flex items-center text-[9px] font-black uppercase tracking-wider text-blue-600 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/60 px-1.5 py-0.5 rounded-full">Prossimo</span>`
    : '';

  const barPct = progress + '%';
  const barColor = isLive ? '#3b82f6' : '#cbd5e1';
  const catHTML = prog.category ? `<span class="uppercase tracking-wide font-bold text-slate-500 dark:text-slate-400">${esc(prog.category)}</span>` : '';
  const posterHTML = prog.poster_url
    ? `<img src="${esc(prog.poster_url)}" alt="" width="48" height="64" loading="lazy" class="w-10 h-14 sm:w-12 sm:h-16 rounded-lg object-cover bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 flex-shrink-0 shadow-sm" onerror="this.onerror=null;this.src='${esc(channel.logo)}';this.className='w-10 h-14 sm:w-12 sm:h-16 rounded-lg object-contain p-1.5 bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 flex-shrink-0'">`
    : '';
  const descriptionHTML = prog.description
    ? `<p class="text-[13px] text-slate-600 dark:text-slate-300 leading-snug line-clamp-2 mt-1">${esc(prog.description)}</p>`
    : '';
  const nextHTML = nextProg
    ? `<p class="text-[12px] text-slate-500 dark:text-slate-400 truncate"><span class="tabular-nums">${fmtTime(nextProg.startTime)}</span> — <span class="text-slate-700 dark:text-slate-300">${esc(nextProg.title)}</span></p>`
    : '';

  // data-program attiva l'overlay; escapiamo le virgolette per l'attributo HTML
  const safeJson = programDataJson ? programDataJson.replace(/"/g, '&quot;') : '';
  const overlayAttr = safeJson ? ` data-program="${safeJson}" style="cursor:pointer"` : '';

  return `
    <div${overlayAttr}>
      <div class="flex gap-2.5">
        ${posterHTML}
        <div class="min-w-0 flex-1">
          <p class="text-[12px] text-slate-500 dark:text-slate-400 mb-0.5 flex items-center gap-1.5 flex-wrap">
            ${liveBadge}
            <span class="tabular-nums font-medium">${fmtTime(prog.startTime)} – ${fmtTime(prog.endTime)}</span>
            ${catHTML}
          </p>
          <p class="text-[15px] font-extrabold text-slate-950 dark:text-slate-100 leading-snug mb-1 line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400">${esc(prog.title)}</p>
          ${descriptionHTML}
        </div>
      </div>
      <div class="h-[3px] w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-600 mb-2">
        <div class="h-full rounded-full transition-all" style="width:${barPct};background:${barColor}"></div>
      </div>
      ${nextHTML}
    </div>
  `;
}

function updateOraCards() {
  const now = Date.now();
  document.querySelectorAll('.ora-card').forEach(card => {
    const contentEl = card.querySelector('.ora-program-content');
    if (!contentEl) return;

    // Il JSON è nell'attributo data-programs (Astro valuta gli attributi, non il contenuto dei <script>)
    let programs = [];
    try { programs = JSON.parse(contentEl.dataset.programs || '[]'); } catch(e) { return; }
    if (!programs.length) return;

    // Dati canale salvati sul <a> (data-channel-*)
    const channelId   = card.dataset.channelId   || '';
    const channelLogo = card.dataset.channelLogo  || '';
    const channelName = card.dataset.channelName  || '';

    const live = programs.find(p => new Date(p.startTime).getTime() <= now && now < new Date(p.endTime).getTime()) || null;
    const justStarted = programs
      .filter(p => new Date(p.startTime).getTime() <= now)
      .sort((a, b) => new Date(b.startTime).getTime() - new Date(a.startTime).getTime())[0] || null;
    const upcoming = programs
      .filter(p => new Date(p.startTime).getTime() > now)
      .sort((a, b) => new Date(a.startTime).getTime() - new Date(b.startTime).getTime())[0] || null;

    const display = live || justStarted || upcoming || null;
    const isLive = !!live;
    const isUpcoming = !live && !justStarted && !!upcoming;

    let progress = 0;
    if (isLive && display) {
      const s = new Date(display.startTime).getTime();
      const e = new Date(display.endTime).getTime();
      progress = Math.min(100, Math.max(0, Math.round(((now - s) / (e - s)) * 100)));
    }

    const nextProg = display
      ? (programs.find(p => new Date(p.startTime).getTime() >= new Date(display.endTime).getTime()) || null)
      : null;

    // Costruisci il JSON per l'overlay
    let programDataJson = null;
    if (display) {
      programDataJson = JSON.stringify({
        id:          display.id,
        title:       display.title,
        startTime:   display.startTime,
        endTime:     display.endTime,
        category:    display.category    || '',
        description: display.description || '',
        poster_url:  display.poster_url  || null,
        channelId,
        channelLogo,
        channelName,
      });
    }

    contentEl.innerHTML = buildCardHTML(display, nextProg, isLive, isUpcoming, progress, programDataJson);
  });
}

// Esegui subito (DOM già pronto — script module è deferred)
updateOraCards();
// Aggiorna ogni 30s per la progress bar
setInterval(updateOraCards, 30000);
</script>
