---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT } from '../utils/timeSlots';
import { buildHubHomeJsonLd } from '../utils/jsonld';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [channels, programs] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelsWithPrograms = channels.filter(ch =>
  programs.some(p => p.channel_id === ch.id)
);

const title       = `Programmi TV Stasera e Ora | Guida TV Completa — 123ProgrammiTV`;
const description = `Programmi TV stasera e ora: guida completa di RAI, Mediaset, La7, Sky e canali italiani con orari aggiornati ogni giorno.`;
const keywords    = `programmi tv, programmi tv stasera, programmi stasera, guida tv, cosa c'è in tv ora`;

const schemas = buildHubHomeJsonLd({
  channels,
  today,
  pageTitle: 'Programmi TV stasera e ora',
  pageDescription: description,
});

// Serializza i channel_id per il conteggio live lato client
const channelIds = JSON.stringify(channelsWithPrograms.map(ch => ch.id));
---

<HubLayout {title} {description} {keywords} canonicalPath="/" {schemas}>

  <!-- ─── HERO ─── -->
  <section class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 py-5 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <div class="flex items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          Live Now
        </span>
        <!-- Aggiornato client-side — placeholder iniziale neutro -->
        <span id="hero-live-count" class="text-slate-400 dark:text-slate-500 text-sm font-medium">
          {channelsWithPrograms.length} canali
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-2">
        Cosa c'è in TV <span class="text-blue-600">Ora</span>
      </h1>

      <!-- Data + ora: data statica (non cambia), ora aggiornata client-side -->
      <p class="text-base sm:text-lg font-medium capitalize text-slate-500 dark:text-slate-400 mb-4">
        {dateLabel} · ore <span id="hero-clock">--:--</span>
      </p>

      <div class="flex items-center gap-3">
        <a href="/stasera" class="inline-flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 font-semibold hover:underline">
          Stasera in TV →
        </a>
        <a href="/domani" class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 font-medium hover:underline">
          Domani →
        </a>
      </div>

    </div>
  </section>

  <!-- ─── LISTA CANALI ─── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="mb-4">
      <ChannelNav />
    </div>

    <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-slate-100 mb-3">
      In onda adesso
    </h2>

    <div class="bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm">
      {channelsWithPrograms.map(channel => {
        const channelPrograms = programs.filter(p => p.channel_id === channel.id);
        return <ChannelCard {channel} programs={channelPrograms} mode="ora" />;
      })}
    </div>

    <SeoHubLinks
      channels={channelsWithPrograms}
      title="Guida TV italiana per ora, stasera e canale"
      intro="Da qui puoi raggiungere le pagine short-tail principali e i palinsesti dei canali più aggiornati."
      maxChannels={48}
    />

  </section>

</HubLayout>

<script define:vars={{ channelIds }}>
// ── Data/ora e live count — aggiornati client-side ──────────────────────────

function fmtTime() {
  return new Date().toLocaleTimeString('it-IT', {
    timeZone: 'Europe/Rome',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

function updateHero() {
  // Orologio
  const clockEl = document.getElementById('hero-clock');
  if (clockEl) clockEl.textContent = fmtTime();

  // Conteggio live: conta le ora-card che hanno un programma live
  const now = Date.now();
  let liveCount = 0;
  document.querySelectorAll('.ora-card').forEach(card => {
    const contentEl = card.querySelector('.ora-program-content');
    if (!contentEl) return;
    try {
      const progs = JSON.parse(contentEl.dataset.programs || '[]');
      const isLive = progs.some(
        p => new Date(p.startTime).getTime() <= now && now < new Date(p.endTime).getTime()
      );
      if (isLive) liveCount++;
    } catch {}
  });

  const countEl = document.getElementById('hero-live-count');
  if (countEl) {
    countEl.textContent = liveCount > 0
      ? `${liveCount} canali in onda`
      : `${JSON.parse(channelIds).length} canali`;
  }
}

// Esegui subito (DOM già pronto — script Astro è deferred module)
updateHero();
// Aggiorna ogni 30s (allineato con il refresh delle card ORA)
setInterval(updateHero, 30000);
</script>
