---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import StaseraPerTe from '../components/StaseraPerTe.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT } from '../utils/timeSlots';
import { buildHubHomeJsonLd } from '../utils/jsonld';
import { buildEveningCandidates } from '../utils/eveningPrefs';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [channels, programs] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelsWithPrograms = channels.filter(ch =>
  programs.some(p => p.channel_id === ch.id)
);

// Conta canali con programma prime time (20:30+ Roma CEST = 18:30+ UTC)
const primeTimeCount = channelsWithPrograms.filter(ch =>
  programs.some(p => {
    if (p.channel_id !== ch.id) return false;
    const d = new Date(p.startTime);
    const m = d.getUTCHours() * 60 + d.getUTCMinutes();
    return m >= 18 * 60 + 30 && m < 21 * 60;
  })
).length;

const title = `inTV stasera: programmi TV di stasera | inTVstasera.it`;
const description = `inTV stasera: scopri programmi, film, serie TV, show e sport in onda questa sera sui principali canali italiani. Orari e programmazione TV aggiornati.`;
const keywords = `inTV stasera, programmi tv stasera, cosa c'è in tv stasera, film in tv stasera, guida tv stasera, programmi prima serata, programmi tv prima serata`;

const schemas = buildHubHomeJsonLd({
  channels,
  today,
  canonicalPath: '/',
  pageTitle: 'inTV stasera: programmi TV di stasera',
  pageDescription: description,
});

const eveningCandidates = buildEveningCandidates(channels, programs);

const featuredWithPoster = eveningCandidates.find(c => c.program.poster_url)?.program
  ?? programs.find(p => p.poster_url && filterStaseraPrograms([p]).length > 0)
  ?? programs.find(p => p.poster_url);

const ogImage = featuredWithPoster?.poster_url ?? '/og/default.png';
const ogImageAlt = featuredWithPoster ? `${featuredWithPoster.title} - inTV stasera` : title;
---

<HubLayout {title} {description} {keywords} canonicalPath="/" {schemas} {ogImage} {ogImageAlt}>

  <!-- ─── HERO ─── -->
  <section class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 py-5 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <div class="flex items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
          📺 inTV stasera
        </span>
        <span class="text-slate-400 dark:text-slate-500 text-sm font-medium">
          Prime time dalle 20:30 · {primeTimeCount} canali
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-2">
        inTV stasera: <span class="text-blue-600">programmi TV di stasera</span>
      </h1>

      <p class="text-base sm:text-lg font-medium capitalize text-slate-500 dark:text-slate-400 mb-2">
        inTV stasera — {dateLabel} · Prime time dalle 20:30
      </p>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mb-4 max-w-3xl leading-relaxed">
        Scopri cosa c'è inTV stasera sui principali canali italiani: film, serie TV, programmi, show, sport e programmi della prima serata, con orari aggiornati.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/ora/" class="inline-flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 font-semibold hover:underline">
          Cosa c'è in TV ora →
        </a>
        <a href="/domani/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 font-medium hover:underline">
          Programmi TV di domani →
        </a>
      </div>

    </div>
  </section>

  <StaseraPerTe candidates={eveningCandidates} pageSlot="stasera" />

  <!-- ─── LISTA CANALI ─── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <ChannelNav />

    <!-- Filtri rapidi categorie -->
    <nav class="flex flex-wrap gap-2 mb-5" aria-label="Categorie stasera">
      <a href="/film-stasera/" class="px-3 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 text-xs font-semibold transition-colors">🎬 Film stasera</a>
      <a href="/serie-stasera/" class="px-3 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-600 hover:text-white text-blue-700 dark:text-blue-300 text-xs font-semibold transition-colors">📺 Serie TV stasera</a>
      <a href="/sport-stasera/" class="px-3 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 hover:bg-green-600 hover:text-white text-green-700 dark:text-green-300 text-xs font-semibold transition-colors">⚽ Sport stasera</a>
    </nav>

    <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-slate-100 mb-3">
      Programmi TV prima serata · dalle 20:30
    </h2>

    <div class="bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm">
      {channelsWithPrograms.map(channel => {
        const channelPrograms = programs.filter(p => p.channel_id === channel.id);
        return <ChannelCard {channel} programs={channelPrograms} mode="stasera" />;
      })}
    </div>

    <SeoHubLinks
      channels={channelsWithPrograms}
      title="inTV stasera: guida TV per canale e categorie"
      intro="Consulta la programmazione completa di stasera per canale, scopri cosa c'è in TV ora o anticipa i programmi di domani."
      maxChannels={48}
    />

  </section>

</HubLayout>
