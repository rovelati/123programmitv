---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import StaseraPerTe from '../components/StaseraPerTe.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT, filterStaseraPrograms } from '../utils/timeSlots';
import { buildHubHomeJsonLd } from '../utils/jsonld';
import { buildEveningCandidates } from '../utils/eveningPrefs';
import { SEO_DESCRIPTIONS } from '../utils/seoDescriptions';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [channels, programs] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelsWithPrograms = channels.filter(ch =>
  programs.some(p => p.channel_id === ch.id)
);

// Conta canali con programma prime time (20:30+ Roma CEST = 18:30+ UTC)
const primeTimeCount = channelsWithPrograms.filter(ch =>
  programs.some(p => {
    if (p.channel_id !== ch.id) return false;
    const d = new Date(p.startTime);
    const m = d.getUTCHours() * 60 + d.getUTCMinutes();
    return m >= 18 * 60 + 30 && m < 21 * 60;
  })
).length;

const title = `inTV stasera: guida ai programmi TV di stasera`;
const description = SEO_DESCRIPTIONS.home;
const keywords = `inTV stasera, programmi tv stasera, cosa c'è in tv stasera, film in tv stasera, guida tv stasera, programmi prima serata, programmi tv prima serata`;

const schemas = buildHubHomeJsonLd({
  channels,
  today,
  canonicalPath: '/',
  pageTitle: 'inTV stasera: programmi TV di stasera',
  pageDescription: description,
});

const eveningCandidates = buildEveningCandidates(channels, programs);

const homeFaqs = [
  {
    question: "A che ora inizia la prima serata sui canali TV italiani?",
    answer: "Sulle reti ammiraglie generaliste (Rai 1, Canale 5, Italia 1, Rete 4, La7, Nove), la prima serata inizia abitualmente tra le 21:25 e le 21:40, al termine degli spazi di access prime time (come game show o strisce informative quotidiane). Sui canali tematici dedicati al cinema e alle serie (come Rai Movie, Iris, Cine34, 20 o Cielo), i programmi della prima serata prendono invece il via puntualmente tra le 21:10 e le 21:20.",
  },
  {
    question: "Come vengono aggiornati i palinsesti e gli orari di inTV stasera?",
    answer: "La nostra redazione acquisisce ed elabora i flussi EPG ufficiali delle emittenti televisive a intervalli regolari (ogni ora), verificando eventuali slittamenti, edizioni speciali dei telegiornali o variazioni dell'ultimo minuto decise dalle reti.",
  },
  {
    question: "Quali canali della TV digitale terrestre e satellite sono coperti?",
    answer: "inTV stasera monitora oltre 50 canali nazionali gratuiti del digitale terrestre, tra cui tutte le reti Rai, l'intero bouquet Mediaset, le reti Discovery/Warner Bros (Nove, Real Time, DMAX, Giallo, Food Network), Cairo Communication (La7, La7d), Sky in chiaro (TV8, Cielo) oltre ai principali canali tematici di cinema, documentari e sport.",
  },
  {
    question: "Dove posso rivedere un programma o un film già andato in onda?",
    answer: "I programmi trasmessi dalle reti in chiaro sono solitamente disponibili in streaming on-demand gratuito sulle rispettive piattaforme ufficiali degli editori: RaiPlay per i canali Rai, Mediaset Infinity per le reti Mediaset, Discovery+ per i canali Warner, e i portali web dedicati di La7 e TV8.",
  },
  {
    question: "Come posso segnalare un errore o un cambio di programmazione?",
    answer: "Puoi contattare direttamente il nostro team inviando una segnalazione a segnalazioni@intvstasera.it o compilando il modulo nella pagina Contatti indicando canale, data e orario del programma.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const allSchemas = [...schemas, faqJsonLd];

const featuredWithPoster = eveningCandidates.find(c => Boolean(c?.poster_url))
  ?? programs.find(p => p.poster_url && filterStaseraPrograms([p]).length > 0)
  ?? programs.find(p => p.poster_url);

const ogImage = featuredWithPoster?.poster_url ?? '/og/default.png';
const ogImageAlt = featuredWithPoster ? `${featuredWithPoster.title} - inTV stasera` : title;
---

<HubLayout {title} {description} {keywords} canonicalPath="/" schemas={allSchemas} {ogImage} {ogImageAlt}>

  <!-- ─── HERO ─── -->
  <section class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 py-5 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <div class="flex items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
          📺 inTV stasera
        </span>
        <span class="text-slate-400 dark:text-slate-500 text-sm font-medium">
          Prime time dalle 20:30 · {primeTimeCount} canali
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-2">
        inTV stasera: <span class="text-blue-600">programmi TV di stasera</span>
      </h1>

      <p class="text-base sm:text-lg font-medium capitalize text-slate-500 dark:text-slate-400 mb-2">
        inTV stasera — {dateLabel} · Prime time dalle 20:30
      </p>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mb-4 max-w-3xl leading-relaxed">
        Scopri cosa c'è inTV stasera sui principali canali italiani: film, serie TV, programmi, show, sport e programmi della prima serata, con orari aggiornati.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/ora/" class="inline-flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 font-semibold hover:underline">
          Cosa c'è in TV ora →
        </a>
        <a href="/domani/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 font-medium hover:underline">
          Programmi TV di domani →
        </a>
      </div>

    </div>
  </section>

  <StaseraPerTe candidates={eveningCandidates} pageSlot="stasera" />

  <!-- ─── LISTA CANALI ─── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <ChannelNav />

    <!-- Filtri rapidi categorie -->
    <nav class="flex flex-wrap gap-2 mb-5" aria-label="Categorie stasera">
      <a href="/film-stasera/" class="px-3 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 text-xs font-semibold transition-colors">🎬 Film stasera</a>
      <a href="/serie-stasera/" class="px-3 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-600 hover:text-white text-blue-700 dark:text-blue-300 text-xs font-semibold transition-colors">📺 Serie TV stasera</a>
      <a href="/sport-stasera/" class="px-3 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 hover:bg-green-600 hover:text-white text-green-700 dark:text-green-300 text-xs font-semibold transition-colors">⚽ Sport stasera</a>
    </nav>

    <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-slate-100 mb-3">
      Programmi TV prima serata · dalle 20:30
    </h2>

    <div class="bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm">
      {channelsWithPrograms.slice(0, 8).map(channel => {
        const channelPrograms = programs.filter(p => p.channel_id === channel.id);
        return <ChannelCard {channel} programs={channelPrograms} mode="stasera" />;
      })}
    </div>

    {channelsWithPrograms.length > 8 && (
      <AdSlot slot={ADSENSE_SLOTS.IN_FEED_CHANNELS} inFeedWrapper={true} minHeight={180} />
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm mt-4">
        {channelsWithPrograms.slice(8).map(channel => {
          const channelPrograms = programs.filter(p => p.channel_id === channel.id);
          return <ChannelCard {channel} programs={channelPrograms} mode="stasera" />;
        })}
      </div>
    )}

    <!-- ─── GUIDA EDITORIALE ALLA PRIMA SERATA TV ─── -->
    <section class="my-12 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 shadow-sm leading-relaxed">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl">📖</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">
          Guida ai programmi TV di stasera: come orientarsi tra i canali
        </h2>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
        <p>
          La prima serata televisiva italiana offre ogni sera centinaia di ore di intrattenimento divise tra reti generaliste storiche e canali tematici verticali. Per scegliere rapidamente cosa guardare stasera senza perdere tempo nello zapping compulsivo, è utile conoscere la tipologia di offerta dei principali canali del digitale terrestre:
        </p>

        <div class="grid sm:grid-cols-3 gap-4 my-6">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-1 text-sm">🎬 Grandi Reti Nazionali</h3>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>Rai 1, Canale 5, Italia 1, Rete 4, La7 e Nove</strong> puntano sui grandi appuntamenti generalisti: fiction in prima visione, grandi reality e varietà del sabato sera, talk show di approfondimento politico e pellicole campioni d'incassi.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-1 text-sm">🍿 Cinema e Grandi Film</h3>
            <p class="text-slate-600 dark:text-slate-400">
              Canali come <strong>Rai Movie, Iris, Cine34, 20 e Cielo</strong> trasmettono cinema 24 ore su 24: dai grandi classici del cinema d'autore italiano ai blockbuster d'azione hollywoodiani e ai thriller d'annata.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-1 text-sm">🔍 Serie Crime & Documentari</h3>
            <p class="text-slate-600 dark:text-slate-400">
              Per gli appassionati di serie investigative e docureality, i punti di riferimento sono <strong>Giallo, Top Crime, DMAX, Focus e Real Time</strong>, con stagioni complete e serate a tema crime, scienza e lifestyle.
            </p>
          </div>
        </div>

        <p>
          <strong>L'orario effettivo di inizio:</strong> a differenza del passato, l'inizio della prima serata in Italia è strettamente legato all'<em>access prime time</em>. Sui canali generalisti i programmi partono generalmente tra le 21:25 e le 21:40, mentre sui canali specializzati (come Iris o Rai 4) la puntata o il film inizia puntualmente alle 21:10.
        </p>
      </div>
    </section>

    <!-- ─── SEZIONE FAQ (DOMANDE FREQUENTI) ─── -->
    <section class="my-10 p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/80">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-2xl">❓</span>
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">
            Domande Frequenti sui Programmi TV di Stasera
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Tutto quello che c'è da sapere su orari, canali e aggiornamenti della guida televisiva.
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {homeFaqs.map((faq) => (
          <details class="group bg-white dark:bg-slate-800/70 rounded-xl border border-slate-200 dark:border-slate-700 p-4 transition-all">
            <summary class="flex justify-between items-center font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 cursor-pointer list-none">
              <span>{faq.question}</span>
              <span class="text-blue-600 dark:text-blue-400 transition-transform group-open:rotate-180">
                ▾
              </span>
            </summary>
            <p class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-700 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <AdSlot slot={ADSENSE_SLOTS.FOOTER_PRE_SEO} className="mt-8 mb-2" minHeight={200} />

    <SeoHubLinks
      channels={channelsWithPrograms}
      title="inTV stasera: guida TV per canale e categorie"
      intro="Consulta la programmazione completa di stasera per canale, scopri cosa c'è in TV ora o anticipa i programmi di domani."
      maxChannels={48}
    />

  </section>

</HubLayout>
