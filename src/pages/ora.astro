---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import CalendarBar from '../components/CalendarBar.astro';
import SnapCard from '../components/SnapCard.astro';
import InteractiveScripts from '../components/InteractiveScripts.astro';
import StaseraPerTe from '../components/StaseraPerTe.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate, buildAllSlotCards } from '../lib/epg';
import { getTodayInRome, formatDateIT, toRomeMinutes } from '../utils/timeSlots';
import { buildHubHomeJsonLd } from '../utils/jsonld';
import { SEO_DESCRIPTIONS } from '../utils/seoDescriptions';
import { buildEveningCandidates } from '../utils/eveningPrefs';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [channels, programs] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelsWithPrograms = channels.filter(ch =>
  programs.some(p => p.channel_id === ch.id)
);

const title = `inTV ora: cosa c'è in TV adesso sui canali`;
const description = SEO_DESCRIPTIONS.ora;
const keywords = `inTV ora, cosa c'è in tv ora, programmi tv ora, in onda adesso, tv adesso, cosa vedere ora in tv, guida tv ora`;

const schemas = buildHubHomeJsonLd({
  channels,
  today,
  canonicalPath: '/ora',
  pageTitle: 'inTV ora: cosa c\'è in TV adesso',
  pageDescription: description,
});

// Serializza i channel_id per il conteggio live lato client
const channelIds = JSON.stringify(channelsWithPrograms.map(ch => ch.id));
const eveningCandidates = buildEveningCandidates(channels, programs);

// Palinsesti compatti per la modalità 'ora' in un unico blocco JSON:
// [id, title, startSec, endSec, category, poster_url]
const liveEpgData: Record<string, [string, string, number, number, string, string | null][]> = {};
for (const ch of channelsWithPrograms) {
  liveEpgData[ch.id] = programs
    .filter(p => p.channel_id === ch.id && toRomeMinutes(p.endTime) >= 5 * 60)
    .map(p => [
      p.id,
      p.title,
      Math.floor(new Date(p.startTime).getTime() / 1000),
      Math.floor(new Date(p.endTime).getTime() / 1000),
      p.category ?? '',
      p.poster_url ?? null,
    ]);
}

const slotCards = buildAllSlotCards(channels, programs);

const firstProgramWithPoster = programs.find(p => p.poster_url);
const ogImage    = firstProgramWithPoster?.poster_url ?? '/og/default.png';
const ogImageAlt = firstProgramWithPoster ? `${firstProgramWithPoster.title} - inTV ora` : title;

// Formattazione data e ora italiana live (Roma)
const formatterRomeDate = new Intl.DateTimeFormat('it-IT', {
  timeZone: 'Europe/Rome',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false
});
const partsDate = formatterRomeDate.formatToParts(new Date());
const getPart = (type: string) => partsDate.find(p => p.type === type)?.value || '';
const capW = getPart('weekday').charAt(0).toUpperCase() + getPart('weekday').slice(1);
const capM = getPart('month').charAt(0).toUpperCase() + getPart('month').slice(1);
const liveHeaderDate = `${capW} ${getPart('day')} ${capM} · Ore ${getPart('hour')}:${getPart('minute')}`;
---

<HubLayout {title} {description} {keywords} canonicalPath="/ora" {schemas} {ogImage} {ogImageAlt}>

  <div class="max-w-6xl mx-auto px-3 sm:px-6 pt-4 space-y-4">

    <!-- ─── BREADCRUMBS & OROLOGIO ITALIANO DINAMICO ─── -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs bg-[#111827]/60 border border-gray-800/80 px-4 py-2.5 rounded-xl">
      <nav class="flex items-center gap-2 text-gray-400 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">inTV stasera</a>
        <span class="text-gray-600">/</span>
        <span class="text-gray-300 font-semibold">In onda adesso</span>
      </nav>
      <div class="flex items-center gap-2 text-gray-200 text-xs sm:text-sm bg-black/50 px-3.5 py-1.5 rounded-xl border border-white/10 shadow-inner">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
        <span id="live-italian-clock" class="font-bold text-white tracking-wide">
          {liveHeaderDate}
        </span>
      </div>
    </div>

    <!-- ─── SEZIONE INTESTAZIONE TITOLO SLEEK & COMPATTA ─── -->
    <section class="border-b border-gray-800/80 pb-3 pt-1">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full bg-[#DA291C]"></span>
            <span id="page-section-h1-text">Programmi TV in onda adesso sui canali italiani</span>
          </h1>
          <p class="text-xs sm:text-sm text-gray-300 mt-1" id="page-section-desc">
            Cosa c'è in TV in questo momento su Rai 1, Canale 5, Italia 1, La7, Nove e oltre 50 canali del digitale terrestre con streaming ufficiale e avanzamento in diretta.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 self-start md:self-auto text-xs font-black uppercase text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 px-3 py-1.5 rounded-xl shadow-lg shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="page-section-badge-text">In Onda Adesso ({channelsWithPrograms.length} canali)</span>
        </span>
      </div>
    </section>

  </div>

  <!-- ─── BARRA NAVIGAZIONE ORARI & CATEGORIE (Ferrari Red & Dark) ─── -->
  <CalendarBar activeSlot="live" />

  <!-- ─── FEED WIDESCREEN 16:9 SNAPCARD CON CAMBIO SLOT ISTANTANEO ─── -->
  <section class="max-w-6xl mx-auto px-3 sm:px-6 py-2">
    <div class="space-y-4">
      {slotCards.map((prog) => (
        <SnapCard
          program={prog}
          isLive={prog.slot === 'live'}
          slot={prog.slot}
          initiallyHidden={prog.slot !== 'live'}
        />
      ))}
    </div>
  </section>

  <StaseraPerTe candidates={eveningCandidates} pageSlot="ora" />

  <!-- ─── NAVIGAZIONE CANALI RAPIDA ─── -->
  <section class="max-w-6xl mx-auto px-3 sm:px-6 py-4">
    <ChannelNav />

    <AdSlot slot={ADSENSE_SLOTS.FOOTER_PRE_SEO} className="mt-8 mb-2" minHeight={200} />

    <SeoHubLinks
      channels={channelsWithPrograms}
      title="inTV ora: guida ai programmi in onda e palinsesti"
      intro="Segui i programmi attualmente in onda su tutti i canali o passa alla guida TV di stasera e domani."
      maxChannels={48}
    />

  </section>

  <InteractiveScripts defaultSlot="live" />

</HubLayout>


