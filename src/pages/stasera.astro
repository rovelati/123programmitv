---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT } from '../utils/timeSlots';
import { buildHubHomeJsonLd } from '../utils/jsonld';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [channels, programs] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelsWithPrograms = channels.filter(ch =>
  programs.some(p => p.channel_id === ch.id)
);

// Conta canali con programma prime time (20:30+ Roma CEST = 18:30+ UTC)
const primeTimeCount = channelsWithPrograms.filter(ch =>
  programs.some(p => {
    if (p.channel_id !== ch.id) return false;
    const d = new Date(p.startTime);
    const m = d.getUTCHours() * 60 + d.getUTCMinutes();
    return m >= 18 * 60 + 30 && m < 21 * 60;
  })
).length;

const schemas = buildHubHomeJsonLd({ channels, today });

const title = `Programmi TV Stasera — ${dateLabel} | 123ProgrammiTV`;
const description = `Guida TV di stasera: scopri il prime time dalle 20:30 su RAI, Mediaset, La7 e tutti i canali italiani. Orari aggiornati.`;
---

<HubLayout {title} {description} canonicalPath="/stasera" {schemas}>

  <!-- ─── HERO ─── -->
  <section class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 py-5 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <div class="flex items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">
          📺 Stasera
        </span>
        <span class="text-slate-400 dark:text-slate-500 text-sm font-medium">
          Prime time dalle 20:30 · {primeTimeCount} canali
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-2">
        Programmi TV <span class="text-blue-600">Stasera</span>
      </h1>

      <p class="text-base sm:text-lg font-medium capitalize text-slate-500 dark:text-slate-400 mb-4">
        {dateLabel} · Prime time dalle 20:30
      </p>

      <div class="flex items-center gap-3">
        <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 font-medium hover:underline">
          ← Cosa c'è ora
        </a>
        <a href="/domani" class="inline-flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 font-semibold hover:underline">
          Domani →
        </a>
      </div>

    </div>
  </section>

  <!-- ─── LISTA CANALI ─── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="mb-4">
      <ChannelNav />
    </div>

    <!-- Filtri rapidi categorie -->
    <nav class="flex flex-wrap gap-2 mb-5" aria-label="Categorie">
      <a href="/film-stasera" class="px-3 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 text-xs font-semibold transition-colors">🎬 Film</a>
      <a href="/serie-stasera" class="px-3 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-600 hover:text-white text-blue-700 dark:text-blue-300 text-xs font-semibold transition-colors">📺 Serie TV</a>
      <a href="/sport-stasera" class="px-3 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 hover:bg-green-600 hover:text-white text-green-700 dark:text-green-300 text-xs font-semibold transition-colors">⚽ Sport</a>
    </nav>

    <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-slate-100 mb-3">
      Prime time · stasera dalle 20:30
    </h2>

    <div class="bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm">
      {channelsWithPrograms.map(channel => {
        const channelPrograms = programs.filter(p => p.channel_id === channel.id);
        return <ChannelCard {channel} programs={channelPrograms} mode="stasera" />;
      })}
    </div>

  </section>

</HubLayout>
