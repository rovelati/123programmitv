---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ChannelSchedule from '../components/ChannelSchedule.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT } from '../utils/timeSlots';
import { buildHubChannelJsonLd } from '../utils/jsonld';
import { getChannelStaseraDescription, getChannelStaseraTitle } from '../utils/seoDescriptions';
import { getChannelStream } from '../utils/channelStreams';
import { getChannelGeo } from '../utils/channelGeo';
import { getDttChannelBySlug } from '../data/dttChannels';
import type { Channel, Program } from '../types';

export async function getStaticPaths() {
  const today = getTodayInRome();
  const [channels, programs] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const program of programs) {
    const list = programsByChannel.get(program.channel_id ?? '') ?? [];
    list.push(program);
    programsByChannel.set(program.channel_id ?? '', list);
  }

  // Pre-calculate live recommendation cards from other channels
  const liveCards = channels
    .map(ch => {
      const chProgs = programsByChannel.get(ch.id) ?? [];
      const live = chProgs.find(p => {
        const s = new Date(p.startTime || (p as any).start_time).getTime();
        const e = new Date(p.endTime || (p as any).end_time).getTime();
        const now = Date.now();
        return now >= s && now < e;
      }) || chProgs[0];
      return live ? {
        id: live.id,
        channel_id: ch.id,
        channel_name: ch.name,
        channel_logo: ch.logo,
        channel_number: ch.number,
        title: live.title,
        description: live.description,
        category: live.category || (live as any).genre,
        start_time: live.startTime || (live as any).start_time,
        rating: live.rating
      } : null;
    })
    .filter(Boolean);

  return channels.map(channel => {
    // Pass ALL programs for today for this channel
    const channelPrograms = programsByChannel.get(channel.id) ?? [];

    return {
      params: { canale: channel.id },
      props: {
        channel,
        programs: channelPrograms,
        allChannels: channels,
        liveCards,
        today,
      },
    };
  });
}

interface Props {
  channel: Channel;
  programs: Program[];
  allChannels: Channel[];
  liveCards: any[];
  today: string;
}

const { channel, programs, allChannels, liveCards, today } = Astro.props;
const channelGeo = getChannelGeo(channel.id);
const dttInfo = getDttChannelBySlug(channel.id);

const title       = getChannelStaseraTitle(channel.name, channel.id);
const description = getChannelStaseraDescription(channel.name, channel.id);
const keywords    = `programmi ${channel.name.toLowerCase()} stasera, ${channel.name.toLowerCase()} stasera, guida tv ${channel.name.toLowerCase()}, programmazione ${channel.name.toLowerCase()} oggi, palinsesto ${channel.name.toLowerCase()}`;
const canonicalPath = `/${channel.id}`;
const schemas = buildHubChannelJsonLd({
  channel,
  programs,
  today,
  canonicalPath,
  pageTitle: title,
  pageDescription: description,
});

const firstProgramWithPoster = programs.find(p => p.poster_url);
const ogImage     = firstProgramWithPoster?.poster_url
  ?? (channel.logo?.startsWith('http') ? channel.logo : channel.logo ? channel.logo : '/og/default.png');
const ogImageAlt  = firstProgramWithPoster
  ? `${firstProgramWithPoster.title} su ${channel.name} stasera`
  : `Programmi ${channel.name} stasera — guida TV`;
---

<HubLayout {title} {description} {keywords} {canonicalPath} {schemas} {ogImage} {ogImageAlt} geo={channelGeo} ogType="website">

  <!-- Main tvch-style Channel Schedule Engine -->
  <main class="min-h-screen">
    <ChannelSchedule
      channel={channel}
      programs={programs}
      allChannels={allChannels}
      liveCards={liveCards}
    />
  </main>

  <!-- Technical DTT & Geo coverage metadata for SEO -->
  <div class="max-w-6xl mx-auto px-3 sm:px-6 pb-12 space-y-8">
    {(dttInfo || channelGeo) && (
      <section class="space-y-4 pt-4 border-t border-gray-800/80" aria-label={`Frequenze Digitale Terrestre e copertura ${channel.name}`}>
        {dttInfo && (
          <div class="p-4 rounded-2xl bg-[#111827]/60 border border-gray-800 text-xs sm:text-sm text-gray-300 shadow-md">
            <div class="flex items-center justify-between flex-wrap gap-2 mb-3 pb-2.5 border-b border-gray-800">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="w-6 h-6 rounded-md bg-red-950/60 text-red-400 flex items-center justify-center font-bold text-xs border border-red-800/40">
                  📺
                </span>
                <span class="font-extrabold text-white">
                  Digitale Terrestre:
                </span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-black bg-[#DA291C] text-white">
                  Canale LCN {dttInfo.lcn}
                </span>
                {dttInfo.lcnHd && (
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-mono text-gray-400 bg-gray-800 border border-gray-700/60">
                    HD {dttInfo.lcnHd}
                  </span>
                )}
              </div>
              <a href="/frequenze-dtt/" class="text-red-400 hover:text-white hover:underline font-semibold text-xs inline-flex items-center gap-1 transition-colors">
                <span>Tutte le frequenze DTT</span>
                <span>&rarr;</span>
              </a>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
              <div>
                <span class="text-gray-400 block text-[10px] uppercase font-bold tracking-wider">Multiplex (Mux)</span>
                <strong class="text-gray-200 mt-0.5 block">{dttInfo.mux}</strong>
              </div>
              <div>
                <span class="text-gray-400 block text-[10px] uppercase font-bold tracking-wider">Frequenza UHF</span>
                <strong class="text-gray-200 font-mono mt-0.5 block">{dttInfo.uhf} ({dttInfo.freqMhz} MHz)</strong>
              </div>
              <div>
                <span class="text-gray-400 block text-[10px] uppercase font-bold tracking-wider">Qualità & Standard</span>
                <strong class="text-gray-200 mt-0.5 block">{dttInfo.quality} · {dttInfo.standard}</strong>
              </div>
              <div>
                <span class="text-gray-400 block text-[10px] uppercase font-bold tracking-wider">Trasmissione</span>
                <strong class="text-emerald-400 mt-0.5 block">In chiaro (100% Free)</strong>
              </div>
            </div>
          </div>
        )}

        {channelGeo && (
          <div class="p-3.5 rounded-2xl bg-[#111827]/60 border border-gray-800 text-xs sm:text-sm text-gray-300 flex items-start sm:items-center gap-2.5 shadow-md">
            <span class="w-7 h-7 rounded-lg bg-red-950/60 text-red-400 flex items-center justify-center font-bold text-xs flex-shrink-0 border border-red-800/40">
              📍
            </span>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-extrabold text-white">
                  {channelGeo.isLocal ? 'Territorio & Sede' : 'Sede'}:
                </span>
                <span class="font-semibold text-gray-200">{channelGeo.city} ({channelGeo.region})</span>
                {channelGeo.badge && (
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-gray-800 text-gray-300 border border-gray-700">
                    {channelGeo.badge}
                  </span>
                )}
              </div>
              <p class="text-gray-400 text-xs mt-0.5">
                Area di copertura: {channelGeo.coverage}
              </p>
            </div>
          </div>
        )}
      </section>
    )}

    <AdSlot slot={ADSENSE_SLOTS.FOOTER_PRE_SEO} className="mt-8 mb-4" minHeight={200} />

    <SeoHubLinks
      channels={allChannels}
      currentChannelId={channel.id}
      title="Altre guide TV"
      intro="Collegamenti utili per esplorare la guida TV per fascia oraria, categoria e canale."
      maxChannels={8}
      compact={true}
    />
  </div>

</HubLayout>
