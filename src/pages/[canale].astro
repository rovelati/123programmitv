---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import HubGrid from '../components/HubGrid.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT, filterStaseraPrograms } from '../utils/timeSlots';
import { buildHubChannelJsonLd } from '../utils/jsonld';
import { HUB_CHANNELS } from '../utils/channelSlug';
import { getChannelStream } from '../utils/channelStreams';
import type { Channel, Program } from '../types';

export async function getStaticPaths() {
  const today = getTodayInRome();
  const [channels, programs] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const program of programs) {
    const list = programsByChannel.get(program.channel_id ?? '') ?? [];
    list.push(program);
    programsByChannel.set(program.channel_id ?? '', list);
  }

  return channels.map(channel => {
    const staseraPrograms = filterStaseraPrograms(programsByChannel.get(channel.id) ?? []);

    const orderedRelated = HUB_CHANNELS
      .map(hub => channels.find(item => item.id === hub.id))
      .filter((item): item is Channel => Boolean(item) && item.id !== channel.id)
      .map(item => ({
        channel: item,
        programs: filterStaseraPrograms(programsByChannel.get(item.id) ?? []),
      }))
      .filter(item => item.programs.length > 0)
      .slice(0, 6);

    return {
      params: { canale: channel.id },
      props: {
        channel,
        programs: staseraPrograms,
        allChannels: channels,
        relatedChannels: orderedRelated,
        today,
      },
    };
  });
}

interface RelatedChannelCard {
  channel: Channel;
  programs: Program[];
}

interface Props {
  channel: Channel;
  programs: Program[];
  allChannels: Channel[];
  relatedChannels: RelatedChannelCard[];
  today: string;
}

const { channel, programs, allChannels, relatedChannels, today } = Astro.props;
const dateLabel = formatDateIT(today);
const stream = getChannelStream(channel.id);

const title       = `${channel.name} stasera: programmi TV e prima serata | inTVstasera.it`;
const description = `Programmi ${channel.name} stasera: guida TV della sera con prima serata e seconda serata, orari aggiornati.`;
const keywords    = `programmi ${channel.name.toLowerCase()} stasera, ${channel.name.toLowerCase()} stasera, guida tv ${channel.name.toLowerCase()}, cosa c'è stasera su ${channel.name.toLowerCase()}`;
const canonicalPath = `/${channel.id}`;
const schemas = buildHubChannelJsonLd({
  channel,
  programs,
  today,
  canonicalPath,
  pageTitle: `${channel.name} stasera: programmi TV e prima serata`,
  pageDescription: description,
});

const ogImage     = channel.logo?.startsWith('http') ? channel.logo : `/og/default.png`;
const ogImageAlt  = `Programmi ${channel.name} stasera — guida TV`;
---

<HubLayout {title} {description} {keywords} {canonicalPath} {schemas} {ogImage} {ogImageAlt} ogType="website">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb items={[
      { label: 'inTV stasera', href: '/' },
      { label: channel.name },
    ]} />
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6 border-b border-slate-100 dark:border-slate-700">
    <div class="flex items-center gap-4 mb-3">
      <div class="w-16 h-16 flex-shrink-0 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-600 overflow-hidden flex items-center justify-center shadow-sm">
        <img
          src={channel.logo}
          alt={`Logo ${channel.name}`}
          width="56"
          height="56"
          class="w-14 h-14 object-contain"
          loading="eager"
          onerror="this.style.display='none'"
        />
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
          {channel.name} stasera: <span class="text-blue-600">programmi e palinsesto</span>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">{dateLabel} · dalle 20:30 alle 02:00</p>
      </div>
    </div>
    <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">
      Palinsesto serale di {channel.name}: prima serata, seconda serata e programmi TV in onda questa sera.
    </p>

    {stream && (
      <a
        href={stream.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white text-sm font-bold rounded-xl transition-colors shadow-sm"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <polygon points="5,3 19,12 5,21"/>
        </svg>
        Guarda in diretta
        <span class="text-red-200 font-normal text-xs">· {stream.label}</span>
        {stream.login_required && (
          <span class="bg-red-800/60 text-red-100 text-[10px] px-1.5 py-0.5 rounded-full font-semibold uppercase tracking-wide">
            login
          </span>
        )}
      </a>
    )}
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-6">
    <ChannelNav currentChannelId={channel.id} />
    <nav class="flex flex-wrap gap-2 text-xs mt-4" aria-label="Navigazione rapida">
      <a href="/" class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-600 hover:text-white dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors font-medium">
        inTV stasera
      </a>
      <a href="/ora/" class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-600 hover:text-white dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors font-medium">
        inTV ora
      </a>
      <a href="/film-stasera/" class="px-3 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 transition-colors font-medium">
        Film stasera
      </a>
      <a href="/serie-stasera/" class="px-3 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-600 hover:text-white text-blue-700 dark:text-blue-300 transition-colors font-medium">
        Serie TV stasera
      </a>
      <a href={`/${channel.id}/domani/`} class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-600 hover:text-white dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors font-medium">
        {channel.name} domani
      </a>
    </nav>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    {programs.length === 0 ? (
      <div class="text-center py-12 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <p class="text-slate-400 dark:text-slate-500">Nessun programma serale disponibile per {channel.name} stasera.</p>
        <a href="/" class="mt-4 inline-block text-blue-600 hover:text-blue-700 text-sm transition-colors">
          ← Torna a inTV stasera
        </a>
      </div>
    ) : (
      <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
        <HubGrid {programs} {channel} mode="stasera" />
      </div>
    )}

    {relatedChannels.length > 0 && (
      <section class="mt-10" aria-labelledby="related-channel-cards-title">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-4">
          <div>
            <h2 id="related-channel-cards-title" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
              Cosa c'è stasera sulle altre reti
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
              Confronta subito film, serie e programmi in prima serata sugli altri canali principali.
            </p>
          </div>
          <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline shrink-0">
            Tutti i canali stasera →
          </a>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {relatedChannels.map(({ channel: relatedChannel, programs: relatedPrograms }) => (
            <div class="rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
              <ChannelCard channel={relatedChannel} programs={relatedPrograms} mode="stasera" />
            </div>
          ))}
        </div>
      </section>
    )}

    <SeoHubLinks
      channels={allChannels}
      currentChannelId={channel.id}
      title="Altre guide TV"
      intro="Collegamenti utili per esplorare la guida TV per fascia oraria, categoria e canale."
      maxChannels={8}
      compact={true}
    />
  </div>

</HubLayout>
