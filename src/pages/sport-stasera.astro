---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ProgramRow from '../components/ProgramRow.astro';
import ChannelNav from '../components/ChannelNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT, filterStaseraPrograms, toRomeMinutes } from '../utils/timeSlots';
import { buildHubCategoryJsonLd } from '../utils/jsonld';
import type { Channel, Program } from '../types';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [allChannels, allPrograms] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelMap = new Map<string, Channel>(allChannels.map(ch => [ch.id, ch]));
const channelOrder = new Map<string, number>(allChannels.map((ch, i) => [ch.id, i]));

/** Canali dedicati allo sport — tutti i loro programmi = sport */
const SPORT_CHANNELS = new Set([
  'rai-sport',
  'sky-sport',
  'sky-sport-calcio',
  'sky-sport24',
  'sport-italia',
  'supertennis',
  'eurosport',
  'eurosport-1',
  'eurosport-2',
  'milan-tv',
  'inter-tv',
  'zona-dazn',
]);

/** Keyword nel titolo che identificano un evento sportivo su canali generalisti */
const SPORT_TITLE_KW = [
  'formula 1', ' f1 ', 'motogp', 'moto2', 'moto3', 'superbike',
  'champions league', 'europa league', 'conference league',
  'serie a', 'serie b', 'coppa italia', 'coppa del mondo',
  'atp', 'wta', 'roland garros', 'wimbledon', 'us open', 'australian open',
  'nba', 'eurolega', 'basket', 'pallacanestro',
  'ciclismo', 'tour de france', 'giro d\'italia', 'vuelta',
  'atletica', 'nuoto', 'scherma',
  'boxe', 'judo', 'karate', 'lotta',
  'rugby', 'pallavolo', 'volley',
  'gran premio', 'grand prix', 'gp ',
  'mondiale', 'europeo', 'olimpiadi', 'paralimpiadi',
];

function isSport(p: Program): boolean {
  const cid = p.channel_id ?? '';

  // 1. Canale sport dedicato
  if (SPORT_CHANNELS.has(cid)) return true;

  // 2. Keyword sport nel titolo
  const titleLow = p.title.toLowerCase();
  if (SPORT_TITLE_KW.some(k => titleLow.includes(k))) return true;

  // 3. Genre/category keyword come fallback
  const catLow = p.category?.toLowerCase() ?? '';
  if (['sport', 'calcio', 'tennis', 'basket', 'motori'].some(k => catLow.includes(k))) return true;

  return false;
}

// Filtra SOLO programmi sportivi della fascia serale/notturna (20:30–02:00)
const sportPrograms = filterStaseraPrograms(allPrograms.filter(isSport));

interface ChannelSportGroup {
  channel: Channel;
  primeTime: Program[];
  secondaSerata: Program[];
  totalPrograms: number;
}

const groupsByChannel = new Map<string, ChannelSportGroup>();

for (const p of sportPrograms) {
  const cid = p.channel_id ?? '';
  const ch = channelMap.get(cid);
  if (!ch) continue;

  if (!groupsByChannel.has(cid)) {
    groupsByChannel.set(cid, {
      channel: ch,
      primeTime: [],
      secondaSerata: [],
      totalPrograms: 0,
    });
  }

  const group = groupsByChannel.get(cid)!;
  const minutes = toRomeMinutes(p.startTime);
  if (minutes >= 20 * 60 && minutes < 23 * 60) {
    group.primeTime.push(p);
  } else {
    group.secondaSerata.push(p);
  }
  group.totalPrograms++;
}

// Ordina i gruppi per audience/ordine canale
const allSportGroups = [...groupsByChannel.values()]
  .filter(g => g.totalPrograms > 0)
  .sort((a, b) => (channelOrder.get(a.channel.id) ?? 999) - (channelOrder.get(b.channel.id) ?? 999));

// Canali con prima serata
const primeTimeGroups = allSportGroups
  .filter(g => g.primeTime.length > 0)
  .map(g => ({ channel: g.channel, programs: g.primeTime }));

// Canali con seconda serata (mostrata successivamente)
const secondaSerataGroups = allSportGroups
  .filter(g => g.secondaSerata.length > 0)
  .map(g => ({ channel: g.channel, programs: g.secondaSerata }));

const totalSport = sportPrograms.length;

const schemas = buildHubCategoryJsonLd({
  categoryName: 'Sport',
  categorySlug: 'sport-stasera',
  programs: sportPrograms,
  today,
});

const title       = `Sport stasera in TV: calcio, motori ed eventi | inTVstasera.it`;
const description = `Sport stasera in TV: eventi di oggi, calcio, tennis, basket, Formula 1, MotoGP, orari e canali italiani aggiornati.`;
const keywords    = `sport stasera in tv, calcio stasera in tv, eventi sportivi stasera, partite stasera in tv`;

const firstSportWithPoster = sportPrograms.find(p => p.poster_url);
const ogImage    = firstSportWithPoster?.poster_url ?? '/og/default.png';
const ogImageAlt = firstSportWithPoster ? `${firstSportWithPoster.title} - Sport stasera in TV` : title;
---

<HubLayout {title} {description} {keywords} canonicalPath="/sport-stasera" {schemas} {ogImage} {ogImageAlt}>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb items={[
      { label: 'inTV stasera', href: '/' },
      { label: 'Sport stasera in TV' },
    ]} />
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6 border-b border-slate-100 dark:border-slate-700">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-1">
      ⚽ Sport stasera in TV — <span class="text-blue-600">{dateLabel}</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">
      {totalSport} {totalSport === 1 ? 'evento sportivo' : 'eventi sportivi'} in onda questa sera.
    </p>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-6">
    <ChannelNav />
    <nav class="flex flex-wrap gap-2 mt-4" aria-label="Altre categorie">
      <a href="/" class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-600 hover:text-white dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 text-xs font-medium transition-colors">Tutti i programmi stasera</a>
      <a href="/film-stasera/" class="px-3 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 text-xs font-medium transition-colors">Film stasera</a>
      <a href="/serie-stasera/" class="px-3 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-600 hover:text-white text-blue-700 dark:text-blue-300 text-xs font-medium transition-colors">Serie TV stasera</a>
    </nav>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12 space-y-10">

    {/* ─── 1. PRIMA SERATA (DALLE 20:30) ─── */}
    <section aria-labelledby="prime-time-heading">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="w-3 h-3 bg-orange-500 rounded-full inline-block"></span>
        <h2 id="prime-time-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
          Prima serata · <span class="text-blue-600">dalle 20:30</span>
        </h2>
        <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300">
          {primeTimeGroups.length} canali
        </span>
      </div>

      {primeTimeGroups.length === 0 ? (
        <div class="p-6 bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 text-center text-slate-400">
          Nessun evento sportivo in prima serata per oggi.
        </div>
      ) : (
        <div class="space-y-4">
          {primeTimeGroups.map(({ channel, programs: chPrograms }) => (
            <div>
              <div class="flex items-center gap-3 mb-2 px-1">
                <div class="w-8 h-8 flex-shrink-0 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-600 overflow-hidden flex items-center justify-center shadow-sm">
                  <img
                    src={channel.logo}
                    alt={`Logo ${channel.name}`}
                    width="26"
                    height="26"
                    class="w-[26px] h-[26px] object-contain"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
                <a
                  href={`/${channel.id}/`}
                  class="text-base font-bold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {channel.name}
                </a>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                  {chPrograms.length} {chPrograms.length === 1 ? 'evento' : 'eventi'}
                </span>
              </div>
              <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
                <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                  {chPrograms.map(program => (
                    <ProgramRow {program} channelId={channel.id} channelLogo={channel.logo} channelName={channel.name} />
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    {/* ─── 2. SECONDA SERATA (SUCCESSIVAMENTE · DALLE 23:00) ─── */}
    {secondaSerataGroups.length > 0 && (
      <section aria-labelledby="seconda-serata-heading" class="pt-6 border-t border-slate-200 dark:border-slate-700/60">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="w-3 h-3 bg-blue-500 rounded-full inline-block"></span>
          <h2 id="seconda-serata-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
            Seconda serata · <span class="text-blue-600">fino alle 02:00</span>
          </h2>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
            {secondaSerataGroups.length} canali
          </span>
        </div>

        <div class="space-y-4">
          {secondaSerataGroups.map(({ channel, programs: chPrograms }) => (
            <div>
              <div class="flex items-center gap-3 mb-2 px-1">
                <div class="w-8 h-8 flex-shrink-0 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-600 overflow-hidden flex items-center justify-center shadow-sm">
                  <img
                    src={channel.logo}
                    alt={`Logo ${channel.name}`}
                    width="26"
                    height="26"
                    class="w-[26px] h-[26px] object-contain"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
                <a
                  href={`/${channel.id}/`}
                  class="text-base font-bold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {channel.name}
                </a>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                  {chPrograms.length} {chPrograms.length === 1 ? 'evento' : 'eventi'}
                </span>
              </div>
              <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
                <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                  {chPrograms.map(program => (
                    <ProgramRow {program} channelId={channel.id} channelLogo={channel.logo} channelName={channel.name} />
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <SeoHubLinks
      channels={allSportGroups.map(group => group.channel)}
      title="Sport stasera: canali e guide correlate"
      intro="Trova gli eventi sportivi per canale e raggiungi le altre pagine principali della guida TV."
      maxChannels={48}
    />
  </div>

</HubLayout>
