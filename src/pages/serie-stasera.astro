---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import ProgramRow from '../components/ProgramRow.astro';
import ChannelNav from '../components/ChannelNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT, filterStaseraPrograms, toRomeMinutes } from '../utils/timeSlots';
import { buildHubCategoryJsonLd } from '../utils/jsonld';
import { SEO_DESCRIPTIONS } from '../utils/seoDescriptions';
import type { Channel, Program } from '../types';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [allChannels, allPrograms] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelMap = new Map<string, Channel>(allChannels.map(ch => [ch.id, ch]));
const channelOrder = new Map<string, number>(allChannels.map((ch, i) => [ch.id, i]));

/** Canali prevalentemente di serie/fiction */
const SERIE_CHANNELS = new Set([
  'top-crime',
  'topcrime',
  'giallo',
  'warner-tv',
]);

const EPISODE_RE = /\b(?:\d{1,2}x\d{1,2}|[Ss]\d{1,2}[Ee]\d{1,2}|[Ee]p\.?\s*\d+|[Ee]pisodio\s+\d+)\b/;
const SERIE_KW = ['serie', 'fiction', 'telefilm', 'sitcom'];

function isSerie(p: Program): boolean {
  const cid = p.channel_id ?? '';

  if (SERIE_CHANNELS.has(cid)) return true;
  if (EPISODE_RE.test(p.title)) return true;

  if (p.description) {
    const desc = p.description.toLowerCase();
    if (desc.includes('episodio') || desc.includes('stagione')) return true;
  }

  const titleLow = p.title.toLowerCase();
  if (['telefilm', 'sitcom'].some(k => titleLow.includes(k))) return true;
  if (SERIE_KW.some(k => p.category?.toLowerCase().includes(k))) return true;

  return false;
}

// Filtra SOLO serie TV della fascia serale/notturna (20:30–02:00)
const seriePrograms = filterStaseraPrograms(allPrograms.filter(isSerie));

interface ChannelSerieGroup {
  channel: Channel;
  primeTime: Program[];
  secondaSerata: Program[];
  totalPrograms: number;
}

const groupsByChannel = new Map<string, ChannelSerieGroup>();

for (const p of seriePrograms) {
  const cid = p.channel_id ?? '';
  const ch = channelMap.get(cid);
  if (!ch) continue;

  if (!groupsByChannel.has(cid)) {
    groupsByChannel.set(cid, {
      channel: ch,
      primeTime: [],
      secondaSerata: [],
      totalPrograms: 0,
    });
  }

  const group = groupsByChannel.get(cid)!;
  const minutes = toRomeMinutes(p.startTime);
  if (minutes >= 20 * 60 && minutes < 23 * 60) {
    group.primeTime.push(p);
  } else {
    group.secondaSerata.push(p);
  }
  group.totalPrograms++;
}

// Ordina i gruppi per audience/posizione canale
const allSerieGroups = [...groupsByChannel.values()]
  .filter(g => g.totalPrograms > 0)
  .sort((a, b) => (channelOrder.get(a.channel.id) ?? 999) - (channelOrder.get(b.channel.id) ?? 999));

// Canali con prima serata
const primeTimeGroups = allSerieGroups
  .filter(g => g.primeTime.length > 0)
  .map(g => ({ channel: g.channel, programs: g.primeTime }));

// Canali con seconda serata (successivamente)
const secondaSerataGroups = allSerieGroups
  .filter(g => g.secondaSerata.length > 0)
  .map(g => ({ channel: g.channel, programs: g.secondaSerata }));

const totalSerie = seriePrograms.length;

const serieFaqs = [
  {
    question: "Quali canali trasmettono serie TV, crime e fiction sul digitale terrestre?",
    answer: "I canali di punta per le serie televisive in chiaro sono Top Crime (canale 39 DTT, specializzato in procedurali americani come Law & Order, Chicago PD, CSI), Giallo (canale 38 DTT, incentrato su polizieschi britannici ed europei), Rai 4 (canale 21 DTT, serie sci-fi e thriller), Warner TV (canale 37 DTT) e Rai Premium (canale 25 DTT, repliche delle grandi fiction italiane).",
  },
  {
    question: "Come posso sapere quale episodio e stagione va in onda stasera?",
    answer: "Nelle schede di inTV stasera indichiamo chiaramente il numero di stagione (es. S3) e di episodio (es. E12), insieme al titolo del singolo episodio e alla sinossi della trama, per evitare di perdere la continuità narrativa.",
  },
  {
    question: "Dove posso rivedere in streaming le puntate perse delle fiction?",
    answer: "Le fiction Rai (es. Doc, Mare Fuori, Don Matteo) sono disponibili integralmente su RaiPlay. Le serie e fiction Mediaset possono essere riviste on-demand su Mediaset Infinity, mentre Discovery+ ospita i contenuti dei canali Giallo e Warner.",
  },
];

const serieFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: serieFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const allSchemas = [...schemas, serieFaqSchema];

const title       = `Serie TV stasera: episodi e fiction di oggi in TV`;
const description = SEO_DESCRIPTIONS.serie;
const keywords    = `serie tv stasera, serie stasera in tv, telefilm stasera, fiction stasera, episodi stasera`;

const firstSerieWithPoster = seriePrograms.find(p => p.poster_url);
const ogImage    = firstSerieWithPoster?.poster_url ?? '/og/default.png';
const ogImageAlt = firstSerieWithPoster ? `${firstSerieWithPoster.title} - Serie TV stasera in TV` : title;
---

<HubLayout {title} {description} {keywords} canonicalPath="/serie-stasera" schemas={allSchemas} {ogImage} {ogImageAlt}>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb items={[
      { label: 'inTV stasera', href: '/' },
      { label: 'Serie TV stasera' },
    ]} />
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6 border-b border-slate-100 dark:border-slate-700">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-1">
      📺 Serie TV stasera in TV — <span class="text-blue-600">{dateLabel}</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">
      {totalSerie} {totalSerie === 1 ? 'serie TV' : 'serie TV'} in onda questa sera sui canali italiani.
    </p>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-6">
    <ChannelNav />
    <nav class="flex flex-wrap gap-2 mt-4" aria-label="Altre categorie">
      <a href="/" class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-600 hover:text-white dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 text-xs font-medium transition-colors">Tutti i programmi stasera</a>
      <a href="/film-stasera/" class="px-3 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 text-xs font-medium transition-colors">Film stasera</a>
      <a href="/sport-stasera/" class="px-3 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 hover:bg-green-600 hover:text-white text-green-700 dark:text-green-300 text-xs font-medium transition-colors">Sport stasera</a>
    </nav>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12 space-y-10">

    {/* ─── 1. PRIMA SERATA (DALLE 20:30) ─── */}
    <section aria-labelledby="prime-time-heading">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="w-3 h-3 bg-orange-500 rounded-full inline-block"></span>
        <h2 id="prime-time-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
          Prima serata · <span class="text-blue-600">dalle 20:30</span>
        </h2>
        <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300">
          {primeTimeGroups.length} canali
        </span>
      </div>

      {primeTimeGroups.length === 0 ? (
        <div class="p-6 bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 text-center text-slate-400">
          Nessuna serie TV in prima serata per oggi.
        </div>
      ) : (
        <div class="space-y-4">
          {primeTimeGroups.map(({ channel, programs: chPrograms }) => (
            <div>
              <div class="flex items-center gap-3 mb-2 px-1">
                <div class="w-8 h-8 flex-shrink-0 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-600 overflow-hidden flex items-center justify-center shadow-sm">
                  <img
                    src={channel.logo}
                    alt={`Logo ${channel.name}`}
                    width="26"
                    height="26"
                    class="w-[26px] h-[26px] object-contain"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
                <a
                  href={`/${channel.id}/`}
                  class="text-base font-bold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {channel.name}
                </a>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                  {chPrograms.length} {chPrograms.length === 1 ? 'serie' : 'serie'}
                </span>
              </div>
              <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
                <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                  {chPrograms.map(program => (
                    <ProgramRow {program} channelId={channel.id} channelLogo={channel.logo} channelName={channel.name} />
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <AdSlot slot={ADSENSE_SLOTS.CHANNEL_MID_CONTENT} className="my-8" minHeight={180} />

    {/* ─── 2. SECONDA SERATA (SUCCESSIVAMENTE · DALLE 23:00) ─── */}
    {secondaSerataGroups.length > 0 && (
      <section aria-labelledby="seconda-serata-heading" class="pt-6 border-t border-slate-200 dark:border-slate-700/60">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="w-3 h-3 bg-blue-500 rounded-full inline-block"></span>
          <h2 id="seconda-serata-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
            Seconda serata · <span class="text-blue-600">fino alle 02:00</span>
          </h2>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
            {secondaSerataGroups.length} canali
          </span>
        </div>

        <div class="space-y-4">
          {secondaSerataGroups.map(({ channel, programs: chPrograms }) => (
            <div>
              <div class="flex items-center gap-3 mb-2 px-1">
                <div class="w-8 h-8 flex-shrink-0 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-600 overflow-hidden flex items-center justify-center shadow-sm">
                  <img
                    src={channel.logo}
                    alt={`Logo ${channel.name}`}
                    width="26"
                    height="26"
                    class="w-[26px] h-[26px] object-contain"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
                <a
                  href={`/${channel.id}/`}
                  class="text-base font-bold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {channel.name}
                </a>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                  {chPrograms.length} {chPrograms.length === 1 ? 'serie' : 'serie'}
                </span>
              </div>
              <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
                <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                  {chPrograms.map(program => (
                    <ProgramRow {program} channelId={channel.id} channelLogo={channel.logo} channelName={channel.name} />
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ─── GUIDA SERIE TV & FICTION ─── -->
    <section class="my-10 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 shadow-sm leading-relaxed">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl">📺</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">
          Guida alle Serie TV e Fiction di stasera in televisione
        </h2>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
        <p>
          Il panorama delle serie televisive sul digitale terrestre spazia dai procedurali investigativi americani alle fiction italiane autoprodotte, passando per le serie crime scandinave e britanniche.
        </p>

        <div class="grid sm:grid-cols-3 gap-4 my-4">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-1 text-sm">🔎 Polizieschi & Procedurali</h3>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>Top Crime, Giallo e 20</strong> offrono serate a tema dedicate alle indagini scientifiche, con doppi o tripli episodi consecutivi delle serie più amate come CSI, NCIS, Law & Order e Vera.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-1 text-sm">🏛️ Fiction Italiane</h3>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>Rai 1 e Canale 5</strong> continuano a dominare gli ascolti con grandi produzioni originali, family drama e thriller all'italiana, spesso disponibili contemporaneamente in 4K e in streaming.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-1 text-sm">🚀 Sci-Fi & Cult</h3>
            <p class="text-slate-600 dark:text-slate-400">
              Per gli appassionati di fantascienza, azione e comedy classica, <strong>Rai 4, Warner TV e Italia 1</strong> offrono maratone nel tardo pomeriggio e in seconda serata.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── FAQ SERIE TV ─── -->
    <section class="my-10 p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/80">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-2xl">❓</span>
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">
            Domande Frequenti sulle Serie TV di Stasera
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Stagioni, canali tematici, repliche e disponibilità on-demand.
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {serieFaqs.map((faq) => (
          <details class="group bg-white dark:bg-slate-800/70 rounded-xl border border-slate-200 dark:border-slate-700 p-4 transition-all">
            <summary class="flex justify-between items-center font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 cursor-pointer list-none">
              <span>{faq.question}</span>
              <span class="text-blue-600 dark:text-blue-400 transition-transform group-open:rotate-180">
                ▾
              </span>
            </summary>
            <p class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-700 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <AdSlot slot={ADSENSE_SLOTS.FOOTER_PRE_SEO} className="mt-8 mb-4" minHeight={200} />

    <SeoHubLinks
      channels={allSerieGroups.map(group => group.channel)}
      title="Serie TV stasera: canali e guide correlate"
      intro="Trova le serie TV e fiction per canale e raggiungi le altre pagine principali della guida TV."
      maxChannels={48}
    />
  </div>

</HubLayout>
