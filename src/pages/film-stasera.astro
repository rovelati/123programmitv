---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import HubGrid from '../components/HubGrid.astro';
import ChannelNav from '../components/ChannelNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInRome, formatDateIT } from '../utils/timeSlots';
import { buildHubCategoryJsonLd } from '../utils/jsonld';
import type { Channel, Program } from '../types';

const today = getTodayInRome();
const dateLabel = formatDateIT(today);

const [allChannels, allPrograms] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

// Mappa channel_id → Channel
const channelMap = new Map<string, Channel>(allChannels.map(ch => [ch.id, ch]));

// ─── Canali esclusivamente/prevalentemente cinematografici ───────────────────
// Cielo è ESCLUSO: alterna film a reality, TG, sport clip → troppi falsi positivi
const FILM_CHANNELS = new Set([
  'iris', 'cine34', 'rai-movie',
  'sky-cinema-uno', 'sky-cinema-due',
  'sky-cinema-drama', 'sky-cinema-comedy',
  'sky-cinema-uno-plus-24', 'sky-cinema-collection',
  'sky-cinema-action', 'sky-cinema-suspense',
  'sky-cinema-romance', 'sky-cinema-family',
  'paramount-network', 'paramount-channel',
]);

// Anno tra parentesi nel titolo o descrizione: segnale fortissimo di film
const YEAR_RE = /\(\s*(?:19|20)\d{2}\s*\)/;

// Parole chiave nel campo genre come fallback
const FILM_KW = ['film', 'cinema', 'movie'];

// ─── Finestra "stasera": dalle 20:00 alle ~04:00 in ora italiana ─────────────
// In CEST (apr–ott, UTC+2): 20:00 CEST = 18:00 UTC.
// In CET  (nov–mar, UTC+1): 20:00 CET  = 19:00 UTC.
// Usiamo >= 18 UTC come soglia: nei mesi invernali include anche 19:00-20:00 locale
// (accettabile). Il confine notturno (01:00-03:59 locale) corrisponde a 23:00-01:59 UTC.
function isStasera(p: Program): boolean {
  const h = new Date(p.startTime).getUTCHours();
  return h >= 18 || h < 2;   // 20:00–03:59 ora di Roma
}

// Durata in minuti
function durationMin(p: Program): number {
  return (new Date(p.endTime).getTime() - new Date(p.startTime).getTime()) / 60000;
}

// Marker di puntata/episodio → è una serie, NON un film
function hasEpisodeMarker(p: Program): boolean {
  const txt = `${p.title} ${p.description ?? ''}`;
  return /\b(?:S\s*\d+\s*E\s*\d+|\d{1,2}x\d{1,2}|Ep\.?\s*\d+|Episodio\s+\d+|Stagione\s+\d+)\b/i.test(txt)
    || /Puntata\s+del\b/i.test(txt);
}

// Rubriche e format NON cinematografici da escludere per titolo
const EXCLUDE_TITLE_FRAGMENTS = [
  'appuntamento al cinema', 'note di cinema', 'movie mag',
  'cinematin',  // cinematinée
  'anica',
  'tg24', 'telegiornale', 'tg2 ', 'tg1 ', 'tg3 ',
  'in pillole', 'mezz\'ora', 'notizie',
  'top 20 ', 'countdown',
  'sfida implacabile',    // Steve Austin (game show)
  'icarus ultra',
  'rubrica',
  'santa messa', 'messa in',
];

function isExcludedByTitle(p: Program): boolean {
  const t = p.title.toLowerCase();
  return EXCLUDE_TITLE_FRAGMENTS.some(f => t.includes(f));
}

// ─── Rilevamento film ─────────────────────────────────────────────────────────
function isFilm(p: Program): boolean {
  // Solo "stasera": dalle 20:00 in poi
  if (!isStasera(p)) return false;

  const cid = p.channel_id ?? '';
  const dur  = durationMin(p);

  // Hard-exclude: rubriche per titolo
  if (isExcludedByTitle(p)) return false;

  // Hard-exclude: episodio di serie TV
  if (hasEpisodeMarker(p)) return false;

  // 1. Canale cinematografico dedicato + durata da film (≥ 70 min)
  if (FILM_CHANNELS.has(cid) && dur >= 70) return true;

  // 2. Anno nel titolo (segnale fortissimo) + durata da film
  if (YEAR_RE.test(p.title) && dur >= 60) return true;

  // 3. Anno nella descrizione + durata da film
  if (p.description && YEAR_RE.test(p.description) && dur >= 70) return true;

  // 4. "Regia di" / "regia:" nella descrizione + durata da lungometraggio
  //    (soglia alta per evitare falsi positivi tipo "Santa Messa — regia di X")
  if (p.description && dur >= 75) {
    const desc = p.description.toLowerCase();
    if (desc.includes('regia di') || desc.includes('regia:')) return true;
  }

  // 5. Keyword nel campo genre (fallback debole) + durata lunga
  if (FILM_KW.some(k => p.category?.toLowerCase().includes(k)) && dur >= 80) return true;

  return false;
}

// ─── Filtra e raggruppa per canale ───────────────────────────────────────────
const filmPrograms = allPrograms.filter(isFilm);
const channelOrder = new Map<string, number>(allChannels.map((ch, i) => [ch.id, i]));

interface FilmGroup { channel: Channel; programs: Program[] }
const groupMap = new Map<string, FilmGroup>();

for (const p of filmPrograms) {
  const cid = p.channel_id ?? '';
  const ch  = channelMap.get(cid);
  if (!ch) continue;
  if (!groupMap.has(cid)) groupMap.set(cid, { channel: ch, programs: [] });
  groupMap.get(cid)!.programs.push(p);
}

// Ordina i gruppi per posizione canale (DB order = audience reach)
const filmGroups: FilmGroup[] = [...groupMap.values()].sort(
  (a, b) => (channelOrder.get(a.channel.id) ?? 999) - (channelOrder.get(b.channel.id) ?? 999),
);

const totalFilms = filmPrograms.length;

const schemas = buildHubCategoryJsonLd({
  categoryName: 'Film',
  categorySlug: 'film-stasera',
  programs: filmPrograms,
  today,
});

const title       = `Film Stasera in TV | Tutti i Film di Oggi — InTVStasera`;
const description = `Film stasera in TV: tutti i titoli di oggi, orari, canali e trame dei film in onda su RAI, Mediaset, Sky e canali italiani.`;
const keywords    = `film stasera, film stasera in tv, cinema stasera, film questa sera, programmazione cinema tv`;
---

<HubLayout {title} {description} {keywords} canonicalPath="/film-stasera" {schemas}>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb items={[
      { label: 'Programmi stasera', href: '/' },
      { label: 'Film stasera in TV' },
    ]} />
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6 border-b border-slate-100 dark:border-slate-700">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-1">
      🎬 Film stasera in TV — <span class="text-blue-600">{dateLabel}</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">
      {totalFilms} {totalFilms === 1 ? 'film' : 'film'} in prima serata sui canali italiani.
    </p>
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-6">
    <ChannelNav />
    <nav class="flex flex-wrap gap-2 mt-4" aria-label="Altre categorie">
      <a href="/" class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-600 hover:text-white dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 text-xs font-medium transition-colors">Tutti i programmi stasera</a>
      <a href="/serie-stasera/" class="px-3 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-600 hover:text-white text-blue-700 dark:text-blue-300 text-xs font-medium transition-colors">Serie TV stasera</a>
      <a href="/sport-stasera/" class="px-3 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 hover:bg-green-600 hover:text-white text-green-700 dark:text-green-300 text-xs font-medium transition-colors">Sport stasera</a>
    </nav>
  </div>

  <!-- Film per canale (solo prima serata e seconda serata) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12 space-y-6">
    {filmGroups.length === 0 ? (
      <p class="text-slate-400 dark:text-slate-500 py-8 text-center">Nessun film in prima serata per questa sera.</p>
    ) : (
      filmGroups.map(({ channel, programs: chPrograms }) => (
        <div>
          {/* Intestazione canale */}
          <div class="flex items-center gap-3 mb-2 px-1">
            <div class="w-9 h-9 flex-shrink-0 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-600 overflow-hidden flex items-center justify-center shadow-sm">
              <img
                src={channel.logo}
                alt={`Logo ${channel.name}`}
                width="30"
                height="30"
                class="w-[30px] h-[30px] object-contain"
                loading="lazy"
                onerror="this.style.display='none'"
              />
            </div>
            <a
              href={`/${channel.id}/`}
              class="text-base font-bold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              {channel.name}
            </a>
            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
              {chPrograms.length} {chPrograms.length === 1 ? 'film' : 'film'}
            </span>
          </div>

          {/* Griglia programmi del canale */}
          <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">
            <HubGrid programs={chPrograms} channel={channel} />
          </div>
        </div>
      ))
    )}

    <SeoHubLinks
      channels={filmGroups.map(group => group.channel)}
      title="Film stasera: canali e altre guide TV"
      intro="Approfondisci i canali che trasmettono film oppure passa alle altre guide short-tail della serata."
      maxChannels={48}
    />
  </div>

</HubLayout>
