---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';

const title = 'Dashboard SEO admin - 123ProgrammiTV';
const description = 'Console SEO interna con import, Search Console, URL Inspection e azioni prioritarie per le head page.';
---

<HubLayout title={title} description={description} canonicalPath="/admin-url-inspection" noindex={true}>
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full bg-orange-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.22em] text-orange-700">
        SEO cockpit
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Dashboard SEO e indicizzazione
      </h1>
      <p class="mt-3 text-base leading-7 text-slate-600 sm:text-lg">
        Vista unica su import EPG, Search Console, URL Inspection e azioni concrete per spingere le pagine head
        di 123ProgrammiTV.
      </p>
    </div>

    <div id="auth-panel" class="mt-8 max-w-md rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">Accesso admin</h2>
      <p class="mt-2 text-sm text-slate-500">
        Stesse credenziali applicative di programmecesoir.fr.
      </p>
      <form id="auth-form" class="mt-6 space-y-4">
        <label class="block">
          <span class="mb-2 block text-sm font-medium text-slate-700">Login</span>
          <input
            id="auth-username"
            type="text"
            autocomplete="username"
            class="w-full rounded-2xl border border-slate-300 px-4 py-3 text-slate-900 outline-none transition focus:border-orange-500"
          />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm font-medium text-slate-700">Password</span>
          <input
            id="auth-password"
            type="password"
            autocomplete="current-password"
            class="w-full rounded-2xl border border-slate-300 px-4 py-3 text-slate-900 outline-none transition focus:border-orange-500"
          />
        </label>
        <p id="auth-error" class="hidden text-sm font-medium text-rose-600"></p>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          Apri la dashboard
        </button>
      </form>
    </div>

    <div id="dashboard-shell" class="hidden mt-8 space-y-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Panoramica SEO operativa</h2>
          <p class="mt-2 text-sm text-slate-500">
            Finestra attuale: ultimi 14 giorni Search Console, con stato live delle head page.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <button
            id="refresh-dashboard"
            type="button"
            class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900"
          >
            Aggiorna
          </button>
          <button
            id="logout-dashboard"
            type="button"
            class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900"
          >
            Logout
          </button>
        </div>
      </div>

      <div id="dashboard-loading" class="rounded-[28px] border border-slate-200 bg-white px-6 py-8 text-sm text-slate-500 shadow-sm">
        Caricamento dati SEO in corso…
      </div>

      <div id="dashboard-error" class="hidden rounded-[28px] border border-rose-200 bg-rose-50 px-6 py-5 text-sm text-rose-700"></div>

      <div id="dashboard-content" class="hidden space-y-8">
        <section id="summary-grid" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4"></section>

        <section class="grid gap-6 xl:grid-cols-[1.15fr_1fr]">
          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-lg font-bold text-slate-900">Import e freschezza contenuti</h3>
                <p class="mt-1 text-sm text-slate-500">
                  Ultimo sync EPG, canali/processati e stato della pipeline dati.
                </p>
              </div>
              <div id="import-status-badge"></div>
            </div>
            <div id="import-metadata" class="mt-6 grid gap-4 sm:grid-cols-2"></div>
          </article>

          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-lg font-bold text-slate-900">Google Search Console</h3>
                <p class="mt-1 text-sm text-slate-500">
                  Click, impression, CTR e posizione media negli ultimi 14 giorni rispetto ai 14 precedenti.
                </p>
              </div>
              <div id="search-window-badge"></div>
            </div>
            <div id="search-summary" class="mt-6 grid gap-4 sm:grid-cols-2"></div>
          </article>
        </section>

        <section class="grid gap-6 xl:grid-cols-[1.3fr_1fr]">
          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-lg font-bold text-slate-900">Stato indicizzazione head page</h3>
                <p class="mt-1 text-sm text-slate-500">
                  URL Inspection live sulle pagine che contano davvero: home, hub e canali principali.
                </p>
              </div>
              <div id="inspection-summary-badge"></div>
            </div>
            <div id="inspection-table" class="mt-6 overflow-hidden rounded-3xl border border-slate-200"></div>
          </article>

          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">Insight e action</h3>
            <p class="mt-1 text-sm text-slate-500">
              Lettura sintetica per decidere dove spingere l’indicizzazione e dove intervenire sui title.
            </p>
            <div id="actions-list" class="mt-5 space-y-3"></div>
            <div id="insights-list" class="mt-6 space-y-3"></div>
          </article>
        </section>

        <section class="grid gap-6 xl:grid-cols-[1fr_1fr]">
          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">Top pagine da Search Console</h3>
            <p class="mt-1 text-sm text-slate-500">
              Le URL che stanno già generando segnali. Quelle head devono salire qui in modo stabile.
            </p>
            <div id="top-pages-table" class="mt-6 overflow-hidden rounded-3xl border border-slate-200"></div>
          </article>

          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">Query search attive</h3>
            <p class="mt-1 text-sm text-slate-500">
              Query che stanno già facendo apparire il sito. Utili per rifinire copy e linking interno.
            </p>
            <div id="top-queries-table" class="mt-6 overflow-hidden rounded-3xl border border-slate-200"></div>
          </article>
        </section>

        <section class="grid gap-6 xl:grid-cols-[1fr_1fr]">
          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">Segnali di distribuzione</h3>
            <p class="mt-1 text-sm text-slate-500">
              Stato tecnico dei job che spingono le head page verso i motori.
            </p>
            <div id="indexing-panel" class="mt-5"></div>
          </article>

          <article class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">GA4 / analytics layer</h3>
            <p class="mt-1 text-sm text-slate-500">
              Stato dell’integrazione server-side GA4. Se manca qualcosa, qui compare l’azione precisa da fare.
            </p>
            <div id="ga4-panel" class="mt-5"></div>
          </article>
        </section>
      </div>
    </div>
  </section>

  <script is:inline>
    const ADMIN_USER = 'bruno';
    const ADMIN_PASS = 'baumicio';
    const AUTH_KEY = '123programmitv_admin_dashboard_auth';
    const AUTH_HEADER = btoa(`${ADMIN_USER}:${ADMIN_PASS}`);

    const authPanel = document.getElementById('auth-panel');
    const dashboardShell = document.getElementById('dashboard-shell');
    const dashboardLoading = document.getElementById('dashboard-loading');
    const dashboardContent = document.getElementById('dashboard-content');
    const dashboardError = document.getElementById('dashboard-error');
    const authError = document.getElementById('auth-error');
    const authForm = document.getElementById('auth-form');
    const usernameInput = document.getElementById('auth-username');
    const passwordInput = document.getElementById('auth-password');

    const summaryGrid = document.getElementById('summary-grid');
    const importStatusBadge = document.getElementById('import-status-badge');
    const importMetadata = document.getElementById('import-metadata');
    const searchWindowBadge = document.getElementById('search-window-badge');
    const searchSummary = document.getElementById('search-summary');
    const inspectionSummaryBadge = document.getElementById('inspection-summary-badge');
    const inspectionTable = document.getElementById('inspection-table');
    const actionsList = document.getElementById('actions-list');
    const insightsList = document.getElementById('insights-list');
    const topPagesTable = document.getElementById('top-pages-table');
    const topQueriesTable = document.getElementById('top-queries-table');
    const indexingPanel = document.getElementById('indexing-panel');
    const ga4Panel = document.getElementById('ga4-panel');

    const refreshButton = document.getElementById('refresh-dashboard');
    const logoutButton = document.getElementById('logout-dashboard');

    function formatDateTime(value) {
      if (!value) return '—';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return '—';
      return parsed.toLocaleString('it-IT', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'Europe/Rome',
      });
    }

    function formatNumber(value) {
      return typeof value === 'number' && !Number.isNaN(value) ? value.toLocaleString('it-IT') : '—';
    }

    function formatPercent(value) {
      return typeof value === 'number' && !Number.isNaN(value) ? `${value.toLocaleString('it-IT', { maximumFractionDigits: 2 })}%` : '—';
    }

    function formatDelta(value, invertGood = false) {
      if (value == null || typeof value !== 'number' || !Number.isFinite(value)) return '<span class="text-slate-400">—</span>';
      const good = invertGood ? value < 0 : value > 0;
      const color = value === 0 ? 'text-slate-400' : good ? 'text-emerald-600' : 'text-rose-600';
      const arrow = value === 0 ? '' : value > 0 ? '↑' : '↓';
      const abs = Math.abs(value);
      return `<span class="${color} font-semibold">${arrow}${abs.toLocaleString('it-IT', { maximumFractionDigits: 1 })}%</span>`;
    }

    function formatPosDelta(value) {
      if (value == null || typeof value !== 'number' || !Number.isFinite(value)) return '<span class="text-slate-400">—</span>';
      // For position, lower is better → negative delta is good
      const good = value < 0;
      const color = value === 0 ? 'text-slate-400' : good ? 'text-emerald-600' : 'text-rose-600';
      const arrow = value === 0 ? '' : value < 0 ? '↑' : '↓';
      return `<span class="${color} font-semibold">${arrow}${Math.abs(value).toFixed(1)}</span>`;
    }

    function getTone(status) {
      const normalized = String(status || '').toLowerCase();
      if (normalized === 'success' || normalized === 'ok') return 'bg-emerald-100 text-emerald-700';
      if (normalized === 'success_with_warnings' || normalized === 'warning') return 'bg-amber-100 text-amber-700';
      if (normalized === 'running') return 'bg-sky-100 text-sky-700';
      if (normalized === 'error') return 'bg-rose-100 text-rose-700';
      return 'bg-slate-100 text-slate-700';
    }

    function getPriorityTone(priority) {
      if (priority === 'high') return 'bg-rose-100 text-rose-700';
      if (priority === 'medium') return 'bg-amber-100 text-amber-700';
      return 'bg-sky-100 text-sky-700';
    }

    function badge(label, tone) {
      return `<span class="inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] ${tone}">${label}</span>`;
    }

    function infoCard(label, value, help) {
      return `
        <div class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">${label}</p>
          <p class="mt-3 text-3xl font-extrabold text-slate-900">${value}</p>
          <p class="mt-2 text-sm text-slate-500">${help}</p>
        </div>
      `;
    }

    async function fetchDashboard(force = false) {
      const response = await fetch(`/search-console/seo-dashboard-latest.json${force ? `?ts=${Date.now()}` : ''}`, {
        headers: {
          'cache-control': 'no-store',
        },
      });

      const payload = await response.json();
      if (!response.ok || !payload?.ok) {
        throw new Error(payload?.error || `Dashboard error ${response.status}`);
      }
      return payload;
    }

    function renderImport(importStatus) {
      const latest = importStatus?.latestRun || {};
      importStatusBadge.innerHTML = badge(latest.status || 'unknown', getTone(latest.status));
      importMetadata.innerHTML = `
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Ultimo run</p>
          <p class="mt-2 text-sm font-semibold text-slate-900">${formatDateTime(latest.completed_at || latest.started_at)}</p>
          <p class="mt-2 text-sm text-slate-500">Fonte: ${latest.trigger_source || '—'}</p>
        </div>
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Volumi</p>
          <div class="mt-2 space-y-1 text-sm text-slate-600">
            <p>Canali: <strong class="text-slate-900">${formatNumber(latest.total_channels)}</strong></p>
            <p>Programmi: <strong class="text-slate-900">${formatNumber(latest.total_programs)}</strong></p>
            <p>Nuovi canali: <strong class="text-slate-900">${formatNumber(latest.new_channels)}</strong></p>
          </div>
        </div>
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Feed</p>
          <div class="mt-2 space-y-1 text-sm text-slate-600">
            <p>TVIT: <strong class="text-slate-900">${formatNumber(latest.primary_channels)}</strong></p>
            <p>IPTV-EPG: <strong class="text-slate-900">${formatNumber(latest.secondary_channels)}</strong></p>
            <p>Canali aggiunti: <strong class="text-slate-900">${formatNumber(latest.secondary_channels_added)}</strong></p>
          </div>
        </div>
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Rigenerazione sito</p>
          <p class="mt-2 text-sm font-semibold text-slate-900">${latest.metadata?.site_regeneration?.github?.ok ? 'GitHub deploy trigger OK' : 'Da verificare'}</p>
          <p class="mt-2 text-sm text-slate-500">${latest.message || '—'}</p>
        </div>
      `;
    }

    function renderSearch(searchPerformance) {
      const current = searchPerformance.currentPeriod || {};
      const deltas = searchPerformance.deltas || {};
      const windowDays = searchPerformance.windowDays || 14;
      searchWindowBadge.innerHTML = badge(`${windowDays} giorni`, 'bg-sky-100 text-sky-700');
      searchSummary.innerHTML = `
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Click</p>
          <p class="mt-2 text-2xl font-extrabold text-slate-900">${formatNumber(current.clicks)}</p>
          <p class="mt-2 text-sm text-slate-500">vs ${windowDays}gg prec.: ${formatDelta(deltas.clicks)}</p>
        </div>
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Impression</p>
          <p class="mt-2 text-2xl font-extrabold text-slate-900">${formatNumber(current.impressions)}</p>
          <p class="mt-2 text-sm text-slate-500">vs ${windowDays}gg prec.: ${formatDelta(deltas.impressions)}</p>
        </div>
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">CTR</p>
          <p class="mt-2 text-2xl font-extrabold text-slate-900">${formatPercent(current.ctr)}</p>
          <p class="mt-2 text-sm text-slate-500">vs ${windowDays}gg prec.: ${formatDelta(deltas.ctr)}</p>
        </div>
        <div class="rounded-3xl bg-slate-50 p-4">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Posizione media</p>
          <p class="mt-2 text-2xl font-extrabold text-slate-900">${typeof current.position === 'number' ? current.position.toFixed(1) : '—'}</p>
          <p class="mt-2 text-sm text-slate-500">vs ${windowDays}gg prec.: ${formatPosDelta(deltas.position)}</p>
        </div>
      `;
    }

    function renderInspection(inspection, searchPerformance) {
      inspectionSummaryBadge.innerHTML = badge(
        `${inspection.summary.indexed}/${inspection.summary.total} indicizzate`,
        inspection.summary.indexed > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700',
      );

      const perfByUrl = new Map((searchPerformance.headTargets || []).map((row) => [row.url, row]));
      const SC_RESOURCE = encodeURIComponent('sc-domain:123programmitv.it');
      const rows = (inspection.results || []).map((row) => {
        const perf = perfByUrl.get(row.url);
        const stateTone = row.indexed ? 'bg-emerald-100 text-emerald-700' : row.status === 'error' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700';
        const stateLabel = row.indexed ? '✓ Indicizzata' : row.status === 'error' ? '✗ Errore API' : '⚠ Non indicizzata';
        const gscInspectUrl = row.inspectionResultLink || `https://search.google.com/search-console/inspect?resource_id=${SC_RESOURCE}&url=${encodeURIComponent(row.url)}`;
        const posDelta = perf?.position && perf.position > 0
          ? `<span class="text-slate-400 text-xs"> pos.${perf.position.toFixed(1)}</span>` : '';
        return `
          <tr class="border-b border-slate-200 last:border-b-0 ${!row.indexed ? 'bg-amber-50/40' : ''}">
            <td class="px-4 py-3 align-top">
              <div class="font-semibold text-slate-900">${row.label}</div>
              <a href="${row.url}" target="_blank" rel="noopener" class="mt-0.5 inline-block text-xs text-slate-400 hover:text-slate-700">${row.url}</a>
            </td>
            <td class="px-4 py-3 align-top">${badge(stateLabel, stateTone)}</td>
            <td class="px-4 py-3 align-top text-sm text-slate-600">${row.coverageState || row.error || '—'}</td>
            <td class="px-4 py-3 align-top text-sm text-slate-600">${formatNumber(perf?.impressions || 0)}${posDelta}</td>
            <td class="px-4 py-3 align-top text-sm text-slate-600">${formatPercent(perf?.ctr || 0)}</td>
            <td class="px-4 py-3 align-top text-sm text-slate-600">${row.lastCrawlTime ? formatDateTime(row.lastCrawlTime) : '<span class="text-amber-600 text-xs font-medium">Mai scansionata</span>'}</td>
            <td class="px-4 py-3 align-top">
              <a href="${gscInspectUrl}" target="_blank" rel="noopener"
                class="inline-flex items-center gap-1 rounded-full border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:border-orange-400 hover:text-orange-700 transition whitespace-nowrap">
                🔍 GSC
              </a>
            </td>
          </tr>
        `;
      }).join('');

      inspectionTable.innerHTML = `
        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
          <thead class="bg-slate-50">
            <tr class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">
              <th class="px-4 py-3">URL</th>
              <th class="px-4 py-3">Stato</th>
              <th class="px-4 py-3">Coverage</th>
              <th class="px-4 py-3">Impr. / Pos.</th>
              <th class="px-4 py-3">CTR</th>
              <th class="px-4 py-3">Ultimo crawl</th>
              <th class="px-4 py-3">Ispeziona</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">${rows}</tbody>
        </table>
      `;
    }

    function renderItems(container, items, emptyLabel) {
      if (!items?.length) {
        container.innerHTML = `<div class="rounded-3xl bg-slate-50 px-4 py-3 text-sm text-slate-500">${emptyLabel}</div>`;
        return;
      }

      container.innerHTML = items.map((item) => {
        const gscLinksHtml = Array.isArray(item.gscLinks) && item.gscLinks.length > 0
          ? `<div class="mt-3 flex flex-wrap gap-2">
              ${item.gscLinks.map((link) => `
                <a href="${link.url}" target="_blank" rel="noopener"
                  class="inline-flex items-center gap-1 rounded-full border border-orange-200 bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700 hover:border-orange-400 hover:bg-orange-100 transition whitespace-nowrap">
                  🔍 ${link.label}
                </a>
              `).join('')}
             </div>`
          : '';
        return `
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h4 class="text-sm font-bold text-slate-900">${item.title}</h4>
              <p class="mt-2 text-sm leading-6 text-slate-600">${item.detail}</p>
            </div>
            ${badge(item.priority || 'info', getPriorityTone(item.priority))}
          </div>
          ${item.target ? `<p class="mt-3 text-xs text-slate-500">${Array.isArray(item.target) ? item.target.join(' · ') : item.target}</p>` : ''}
          ${gscLinksHtml}
        </div>
        `;
      }).join('');
    }

    function renderTable(container, columns, rows, emptyLabel) {
      if (!rows?.length) {
        container.innerHTML = `<div class="px-4 py-6 text-sm text-slate-500">${emptyLabel}</div>`;
        return;
      }
      container.innerHTML = `
        <table class="min-w-full divide-y divide-slate-200 text-left">
          <thead class="bg-slate-50">
            <tr class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">
              ${columns.map((column) => `<th class="px-4 py-3">${column}</th>`).join('')}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            ${rows.join('')}
          </tbody>
        </table>
      `;
    }

    function renderTopTables(searchPerformance) {
      const toDisplayPath = (value) => {
        try {
          const parsed = new URL(value);
          return parsed.pathname || '/';
        } catch {
          return value || '/';
        }
      };

      renderTable(
        topPagesTable,
        ['Pagina', 'Click', 'Impression', 'CTR', 'Pos.'],
        (searchPerformance.topPages || []).slice(0, 20).map((row) => `
          <tr>
            <td class="px-4 py-3">
              <a href="${row.key}" target="_blank" rel="noopener" class="text-sm font-medium text-slate-900 hover:text-orange-700">${toDisplayPath(row.key)}</a>
            </td>
            <td class="px-4 py-3 text-sm text-slate-600">${formatNumber(row.clicks)}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${formatNumber(row.impressions)}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${formatPercent(row.ctr)}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${typeof row.position === 'number' ? row.position.toFixed(2) : '—'}</td>
          </tr>
        `),
        'Nessuna pagina rilevata nella finestra attuale.',
      );

      renderTable(
        topQueriesTable,
        ['Query', 'Click', 'Impression', 'CTR', 'Pos.'],
        (searchPerformance.topQueries || []).slice(0, 20).map((row) => `
          <tr>
            <td class="px-4 py-3 text-sm font-medium text-slate-900">${row.key || '—'}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${formatNumber(row.clicks)}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${formatNumber(row.impressions)}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${formatPercent(row.ctr)}</td>
            <td class="px-4 py-3 text-sm text-slate-600">${typeof row.position === 'number' ? row.position.toFixed(2) : '—'}</td>
          </tr>
        `),
        'Nessuna query rilevata nella finestra attuale.',
      );
    }

    function renderIndexingPanel(googleIndexing) {
      const { googleIndexing: indexing, websub } = googleIndexing;

      const indexingCard = indexing.status !== 'ok' || !indexing.payload
        ? `<div class="rounded-3xl bg-amber-50 px-4 py-4 text-sm text-amber-700">Google Indexing: report non disponibile in modo affidabile.</div>`
        : `
          <div class="rounded-3xl bg-slate-50 p-4">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Google Indexing API</p>
            <div class="mt-2">${badge(indexing.payload.status || 'unknown', getTone(indexing.payload.status))}</div>
            <p class="mt-2 text-sm text-slate-500">${formatDateTime(indexing.payload.generatedAt)}</p>
            <p class="mt-2 text-sm text-slate-600">Success: <strong class="text-slate-900">${formatNumber(indexing.payload.summary?.success)}</strong> / ${formatNumber(indexing.payload.summary?.attempted)}</p>
          </div>
        `;

      const websubCard = websub.status !== 'ok' || !websub.payload
        ? `<div class="rounded-3xl bg-amber-50 px-4 py-4 text-sm text-amber-700">WebSub: report non disponibile o job non ancora eseguito.</div>`
        : `
          <div class="rounded-3xl bg-slate-50 p-4">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">WebSub</p>
            <div class="mt-2">${badge(websub.payload.status || 'unknown', getTone(websub.payload.status))}</div>
            <p class="mt-2 text-sm text-slate-500">${formatDateTime(websub.payload.generatedAt)}</p>
            <p class="mt-2 text-sm text-slate-600">Hub OK: <strong class="text-slate-900">${formatNumber(websub.payload.summary?.successfulHubs)}</strong></p>
          </div>
        `;

      indexingPanel.innerHTML = `
        <div class="grid gap-4 sm:grid-cols-2">
          ${indexingCard}
          ${websubCard}
        </div>
      `;
    }

    function renderGa4Panel(ga4) {
      if (ga4.status === 'ok') {
        ga4Panel.innerHTML = `
          <div class="rounded-3xl bg-emerald-50 px-4 py-4 text-sm text-emerald-700">
            Data API GA4 attiva su property ${ga4.propertyId}. Measurement ID: ${ga4.measurementId}.
          </div>
        `;
        return;
      }

      const tone = ga4.status === 'error' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700';
      ga4Panel.innerHTML = `
        <div class="rounded-3xl ${tone} px-4 py-4 text-sm">
          <p class="font-semibold">${ga4.message || 'Layer GA4 non pronto.'}</p>
          <p class="mt-2">Measurement ID: ${ga4.measurementId || '—'}</p>
          <p class="mt-2">${ga4.action || ''}</p>
          ${ga4.activationUrl ? `<p class="mt-2"><a class="underline" href="${ga4.activationUrl}" target="_blank" rel="noopener">Apri pagina di attivazione API</a></p>` : ''}
        </div>
      `;
    }

    function renderSummary(payload) {
      const current = payload.searchPerformance.currentPeriod || {};
      const deltas = payload.searchPerformance.deltas || {};
      const windowDays = payload.searchPerformance.windowDays || 14;
      const latestImport = payload.importStatus.latestRun || {};
      summaryGrid.innerHTML = [
        infoCard(`Impression ${windowDays}g`, formatNumber(current.impressions), `Visibilità organica ${windowDays} giorni. ${formatDelta(deltas.impressions)} vs periodo prec.`),
        infoCard(`Click ${windowDays}g`, formatNumber(current.clicks), `Click organici reali negli ultimi ${windowDays} giorni. ${formatDelta(deltas.clicks)} vs periodo prec.`),
        infoCard(‘Head indicizzate’, `${formatNumber(payload.inspection.summary.indexed)}/${formatNumber(payload.inspection.summary.total)}`, ‘Pagine head riconosciute da Google URL Inspection API.’),
        infoCard(‘Ultimo import’, formatDateTime(latestImport.completed_at || latestImport.started_at), `Stato: <strong>${latestImport.status || ‘—‘}</strong>. Freschezza ultima pipeline EPG.`),
      ].join(‘’);
    }

    function renderDashboard(payload) {
      renderSummary(payload);
      renderImport(payload.importStatus);
      renderSearch(payload.searchPerformance);
      renderInspection(payload.inspection, payload.searchPerformance);
      renderItems(actionsList, payload.actions, 'Nessuna action prioritaria generata.');
      renderItems(insightsList, payload.insights, 'Nessun insight disponibile.');
      renderTopTables(payload.searchPerformance);
      renderIndexingPanel({ googleIndexing: payload.googleIndexing, websub: payload.websub });
      renderGa4Panel(payload.ga4);
    }

    async function loadDashboard(force = false) {
      dashboardLoading.classList.remove('hidden');
      dashboardContent.classList.add('hidden');
      dashboardError.classList.add('hidden');
      dashboardError.textContent = '';

      try {
        const payload = await fetchDashboard(force);
        renderDashboard(payload);
        dashboardContent.classList.remove('hidden');
      } catch (error) {
        dashboardError.textContent = error.message || 'Errore durante il caricamento della dashboard.';
        dashboardError.classList.remove('hidden');
      } finally {
        dashboardLoading.classList.add('hidden');
      }
    }

    function setAuthed(value) {
      if (value) {
        window.sessionStorage.setItem(AUTH_KEY, '1');
        authPanel.classList.add('hidden');
        dashboardShell.classList.remove('hidden');
        loadDashboard();
        return;
      }
      window.sessionStorage.removeItem(AUTH_KEY);
      authPanel.classList.remove('hidden');
      dashboardShell.classList.add('hidden');
      dashboardContent.classList.add('hidden');
      dashboardError.classList.add('hidden');
    }

    authForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (usernameInput.value === ADMIN_USER && passwordInput.value === ADMIN_PASS) {
        authError.classList.add('hidden');
        setAuthed(true);
        return;
      }
      authError.textContent = 'Identificativi non validi.';
      authError.classList.remove('hidden');
    });

    refreshButton?.addEventListener('click', () => loadDashboard(true));
    logoutButton?.addEventListener('click', () => setAuthed(false));

    if (typeof window !== 'undefined' && window.sessionStorage.getItem(AUTH_KEY) === '1') {
      setAuthed(true);
    }
  </script>
</HubLayout>
