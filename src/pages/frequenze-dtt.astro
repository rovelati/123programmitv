---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { DTT_CHANNELS } from '../data/dttChannels';
import { SEO_DESCRIPTIONS } from '../utils/seoDescriptions';
import { sitePath } from '../utils/urls';

const title = 'Frequenze DTT e Numerazione Canali TV: Guida Digitale Terrestre';
const description = SEO_DESCRIPTIONS.frequenzeDtt;
const keywords = 'frequenze dtt, canali digitale terrestre, lista lcn tv, frequenze tv digitale terrestre, mux rai frequenze, mux mediaset frequenze, risintonizzazione tv';
const canonicalPath = '/frequenze-dtt';

// Structured data FAQ & ItemList for Google / Bing Rich Results
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Come risintonizzare i canali del digitale terrestre sulla Smart TV?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Per risintonizzare i canali: 1. Accedi al Menu della TV o del decoder con il telecomando. 2. Seleziona Impostazioni / Canali / Sintonia. 3. Scegli "Sintonia Automatica Digitale Terrestre (DTT)". 4. Attiva l\'ordinamento automatico LCN per assegnare i numeri corretti ai canali. 5. Avvia la scansione e attendi il completamento.',
        },
      },
      {
        '@type': 'Question',
        name: 'Perché alcuni canali TV non si vedono o si vedono a scatti?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Se non vedi alcuni canali o il segnale squadretta, le cause più frequenti sono: 1. Mancata risintonizzazione dopo un aggiornamento delle frequenze Mux. 2. Cavo antenna danneggiato o mal collegato. 3. TV o decoder non compatibile con lo standard DVB-T MPEG-4 HD o DVB-T2. 4. Filtro 5G/4G mancante sull\'impianto antenna se i ripetitori telefonici creano interferenze.',
        },
      },
      {
        '@type': 'Question',
        name: 'Qual è la numerazione LCN dei canali TV principali in Italia?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'In Italia i canali principali occupano le prime posizioni LCN: 1 Rai 1 HD, 2 Rai 2 HD, 3 Rai 3 HD, 4 Rete 4 HD, 5 Canale 5 HD, 6 Italia 1 HD, 7 La7 HD, 8 TV8 HD, 9 NOVE HD, 20 Mediaset 20 HD. Le versioni HD duplicate si trovano spesso anche dal 501 in su.',
        },
      },
      {
        '@type': 'Question',
        name: 'Cosa significa DVB-T2 e quali TV sono compatibili?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Il DVB-T2 è l\'evoluzione dello standard di trasmissione digitale terrestre che, abbinato al codec HEVC Main 10 a 10 bit, consente trasmissioni in alta definizione e 4K con minor consumo di banda. Tutte le TV prodotte e vendute in Italia dal 22 dicembre 2018 sono obbligate per legge a supportare il DVB-T2 HEVC.',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Elenco Canali e Frequenze Digitale Terrestre LCN Italia',
    description: 'Tabella ufficiale dei canali TV del digitale terrestre italiano con numerazione LCN, Multiplex e canali UHF.',
    numberOfItems: DTT_CHANNELS.length,
    itemListElement: DTT_CHANNELS.map((ch, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${ch.name} (LCN ${ch.lcn})`,
      description: `${ch.name} in onda su ${ch.mux} (${ch.uhf}) in qualità ${ch.quality}.`,
    })),
  },
];
---

<HubLayout {title} {description} {keywords} {canonicalPath} {schemas}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb items={[
      { label: 'inTV stasera', href: '/' },
      { label: 'Frequenze DTT & Canali TV' },
    ]} />
  </div>

  <!-- HERO SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">
        📡 Digitale Terrestre DTT & DVB-T2
      </span>
      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
        Aggiornato 2026
      </span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-3">
      Frequenze TV e Numerazione <span class="text-blue-600 dark:text-blue-400">Canali DTT</span>
    </h1>

    <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      Guida completa alle <strong>frequenze del digitale terrestre in Italia</strong>: elenco numerazione LCN nazionale,
      multiplex (Mux Rai, Mediaset, Cairo, Persidera), canali UHF e guida pratica alla risintonizzazione della tua TV.
    </p>

    <!-- KPI BADGES -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl">
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Canali Mappati</span>
        <div class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-0.5">{DTT_CHANNELS.length}+</div>
        <p class="text-[11px] text-slate-500">Tutti con LCN nazionale</p>
      </div>
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Standard Video</span>
        <div class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-0.5">HD & 4K</div>
        <p class="text-[11px] text-slate-500">MPEG-4 AVC e HEVC</p>
      </div>
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Multiplex</span>
        <div class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-0.5">10 Mux</div>
        <p class="text-[11px] text-slate-500">Nazionali e regionali</p>
      </div>
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Accesso</span>
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-0.5">100% Free</div>
        <p class="text-[11px] text-slate-500">In chiaro senza abbonamento</p>
      </div>
    </div>
  </section>

  <!-- CONTROLS & FILTER SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 mb-6">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="dtt-search"
          placeholder="Cerca canale o LCN... es. Rai 5, 20, Mediaset"
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all shadow-xs"
        />
      </div>

      <!-- Quick stats -->
      <div class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-2">
        <span>Mostrati:</span>
        <strong id="visible-count" class="text-slate-900 dark:text-slate-100 font-bold">{DTT_CHANNELS.length}</strong>
        <span>canali</span>
      </div>
    </div>

    <!-- Filter Operator Pills -->
    <div class="flex flex-wrap items-center gap-2 pb-2" id="filter-operators">
      <button
        data-filter="all"
        class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-blue-600 text-white shadow-xs"
      >
        Tutti i Canali ({DTT_CHANNELS.length})
      </button>
      <button
        data-filter="RAI"
        class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        RAI
      </button>
      <button
        data-filter="Mediaset"
        class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Mediaset
      </button>
      <button
        data-filter="Warner Bros. Discovery"
        class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Discovery & Warner
      </button>
      <button
        data-filter="Cairo / La7"
        class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        La7 / Cairo
      </button>
      <button
        data-filter="Sky"
        class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Sky in chiaro
      </button>
    </div>
  </section>

  <!-- TABLE CONTAINER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <div class="overflow-x-auto bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
      <table class="w-full text-left border-collapse" id="dtt-table">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-800/50 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4 text-center w-16">LCN</th>
            <th class="py-3.5 px-4">Canale TV</th>
            <th class="py-3.5 px-4">Gruppo / Mux</th>
            <th class="py-3.5 px-4">Frequenza UHF</th>
            <th class="py-3.5 px-4 text-center">Qualità</th>
            <th class="py-3.5 px-4">Genere</th>
            <th class="py-3.5 px-4 text-right">Guida TV</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
          {DTT_CHANNELS.map(ch => (
            <tr
              class="dtt-row hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors"
              data-name={ch.name.toLowerCase()}
              data-lcn={ch.lcn}
              data-operator={ch.operator}
              data-mux={ch.mux.toLowerCase()}
            >
              <!-- LCN Badge -->
              <td class="py-3.5 px-4 text-center whitespace-nowrap">
                <span class="inline-flex items-center justify-center min-w-[34px] px-2 py-1 rounded-lg bg-blue-600 text-white font-black text-xs shadow-xs">
                  {ch.lcn}
                </span>
                {ch.lcnHd && (
                  <span class="block text-[10px] text-slate-400 font-mono mt-0.5" title={`Disponibile anche al numero ${ch.lcnHd}`}>
                    HD {ch.lcnHd}
                  </span>
                )}
              </td>

              <!-- Canale Nome & Note -->
              <td class="py-3.5 px-4">
                <div class="font-bold text-slate-900 dark:text-slate-100">
                  {ch.name}
                </div>
                {ch.notes && (
                  <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1 mt-0.5">
                    {ch.notes}
                  </p>
                )}
              </td>

              <!-- Operatore / Mux -->
              <td class="py-3.5 px-4 whitespace-nowrap">
                <span class="font-medium text-slate-800 dark:text-slate-200 block text-xs">
                  {ch.mux}
                </span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">
                  {ch.operator}
                </span>
              </td>

              <!-- Frequenza & UHF -->
              <td class="py-3.5 px-4 whitespace-nowrap">
                <span class="font-mono text-xs font-semibold text-slate-700 dark:text-slate-300 block">
                  {ch.uhf}
                </span>
                <span class="text-[11px] text-slate-400 font-mono">
                  {ch.freqMhz} MHz
                </span>
              </td>

              <!-- Qualità Badge -->
              <td class="py-3.5 px-4 text-center whitespace-nowrap">
                {ch.quality === '4K Ultra HD' ? (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300">
                    4K HEVC
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300">
                    HD 1080i
                  </span>
                )}
              </td>

              <!-- Genere -->
              <td class="py-3.5 px-4 whitespace-nowrap text-xs text-slate-600 dark:text-slate-400">
                {ch.genre}
              </td>

              <!-- Azione Guida TV -->
              <td class="py-3.5 px-4 text-right whitespace-nowrap">
                {ch.slug ? (
                  <a
                    href={sitePath(`/${ch.slug}`)}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 hover:bg-blue-50 dark:bg-slate-800 dark:hover:bg-blue-900/30 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                  >
                    <span>Stasera</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </a>
                ) : (
                  <span class="text-xs text-slate-400">—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- GUIDA ALLA RISINTONIZZAZIONE -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <div class="bg-gradient-to-br from-slate-50 to-blue-50/40 dark:from-slate-900 dark:to-slate-800/80 rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2 block">
          Guida Pratica
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
          Come risintonizzare la TV o il Decoder
        </h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
          Se non ricevi alcuni canali o noti squadrettamenti dell'immagine, esegui una scansione automatica per aggiornare
          le nuove frequenze dei multiplex nazionali:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-black text-sm mb-2">1</div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm mb-1">Accedi al Menu</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Premi il tasto <strong>Menu</strong> o <strong>Home</strong> sul telecomando della tua Smart TV o decoder.
            </p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-black text-sm mb-2">2</div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm mb-1">Sezione Canali / Sintonia</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Naviga su <em>Impostazioni</em> &gt; <em>Canali</em> &gt; <em>Sintonia automatica DTT</em> (Digitale Terrestre).
            </p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-black text-sm mb-2">3</div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm mb-1">Attiva Ordinamento LCN</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Verifica che l'opzione <strong>Ordinamento Automatico LCN</strong> sia attiva per disporre i canali da 1 in poi.
            </p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-black text-sm mb-2">4</div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm mb-1">Avvia la Scansione</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Seleziona <em>Avvia</em> e attendi qualche minuto fino al termine. I canali verranno memorizzati automaticamente.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16">
    <div class="border-t border-slate-200 dark:border-slate-800 pt-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-6">
        Domande Frequenti su Frequenze e Canali DTT
      </h2>

      <div class="space-y-4 max-w-4xl">
        <details class="group bg-white dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-2xs cursor-pointer">
          <summary class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base list-none flex items-center justify-between gap-3">
            <span>Perché alcuni canali non si vedono o squadrettano?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            I motivi principali sono un mancato aggiornamento delle frequenze Mux (risolvibile con una nuova sintonia automatica),
            un cavo d'antenna logorato oppure interferenze provocate dalle celle telefoniche 4G/5G vicine (risolvibili con un filtro LTE sull'antenna).
          </p>
        </details>

        <details class="group bg-white dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-2xs cursor-pointer">
          <summary class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base list-none flex items-center justify-between gap-3">
            <span>Che differenza c'è tra DVB-T e DVB-T2 HEVC?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Il DVB-T2 è lo standard televisivo di seconda generazione che adotta l'efficiente compressione HEVC (High Efficiency Video Coding).
            Permette una qualità visiva nettamente superiore (Full HD a bitrate elevato e 4K Ultra HD) occupando meno banda radiofonica.
          </p>
        </details>

        <details class="group bg-white dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-2xs cursor-pointer">
          <summary class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base list-none flex items-center justify-between gap-3">
            <span>Come vedere Rai 4K sul digitale terrestre?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Rai 4K è visibile al numero LCN 101. È necessario possedere una Smart TV 4K Ultra HD con sintonizzatore DVB-T2 HEVC Main 10
            e supporto alla tecnologia HbbTV interattiva connessa a Internet o ricezione diretta dal Mux Rai B sul canale UHF 40.
          </p>
        </details>
      </div>
    </div>
  </section>
</HubLayout>

<script is:inline>
  (function() {
    const searchInput = document.getElementById('dtt-search');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const rows = document.querySelectorAll('.dtt-row');
    const visibleCount = document.getElementById('visible-count');

    let currentFilter = 'all';
    let currentSearch = '';

    function filterTable() {
      let count = 0;
      rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const lcn = row.getAttribute('data-lcn') || '';
        const operator = row.getAttribute('data-operator') || '';
        const mux = row.getAttribute('data-mux') || '';

        const matchesOperator = (currentFilter === 'all') || (operator === currentFilter);
        const matchesSearch = !currentSearch ||
          name.includes(currentSearch) ||
          lcn === currentSearch ||
          mux.includes(currentSearch);

        if (matchesOperator && matchesSearch) {
          row.style.display = '';
          count++;
        } else {
          row.style.display = 'none';
        }
      });

      if (visibleCount) {
        visibleCount.textContent = count;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentSearch = (e.target.value || '').trim().toLowerCase();
        filterTable();
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-blue-600', 'text-white');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });
        this.classList.add('active', 'bg-blue-600', 'text-white');
        this.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');

        currentFilter = this.getAttribute('data-filter') || 'all';
        filterTable();
      });
    });
  })();
</script>
