---
export const prerender = true;

import HubLayout from '../layouts/HubLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { UPCOMING_SERIES } from '../data/upcomingSeries';
import { SEO_DESCRIPTIONS } from '../utils/seoDescriptions';

const title = 'Uscite Serie TV e Prossimi Episodi: Calendario e Countdown';
const description = SEO_DESCRIPTIONS.usciteSerieTv;
const keywords = 'quando esce serie tv, calendario uscite serie tv, countdown serie tv, a che ora esce su netflix, prossimi episodi serie tv, data uscita serie tv';
const canonicalPath = '/uscite-serie-tv';

// FAQ & ItemList for Rich Results
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'A che ora escono i nuovi episodi delle serie TV su Netflix in Italia?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Su Netflix in Italia i nuovi episodi e le stagioni complete vengono rilasciati quasi sempre alle ore 09:00 del mattino (fuso orario italiano CET/CEST), corrispondenti alla mezzanotte dell\'ora del Pacifico (PST) della sede centrale in California.',
        },
      },
      {
        '@type': 'Question',
        name: 'A che ora escono le puntate su Sky e NOW in contemporanea USA?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Per le grandi produzioni HBO (come House of the Dragon e The Last of Us), gli episodi debuttano in simulcast alle ore 03:00 della notte in lingua originale con sottotitoli, per poi essere disponibili on demand dalle prime ore del mattino e trasmessi la sera stessa alle 21:15 doppiati in italiano.',
        },
      },
      {
        '@type': 'Question',
        name: 'A che ora escono le nuove serie su Prime Video e Disney+?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Su Disney+ le novità debuttano alle ore 09:00 del mattino, mentre su Amazon Prime Video gli episodi originali vengono spesso resi disponibili già tra la mezzanotte e le ore 01:00 UTC (ore 02:00-03:00 italiane).',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Calendario Uscite Serie TV e Nuove Stagioni',
    description: 'Elenco prossime uscite serie TV con data di rilascio e orario per Netflix, Prime Video, Disney+ e Sky.',
    numberOfItems: UPCOMING_SERIES.length,
    itemListElement: UPCOMING_SERIES.map((s, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: `${s.title} (Stagione ${s.season})`,
      description: `Uscita prevista il ${new Date(s.releaseDate).toLocaleDateString('it-IT')} su ${s.platform}.`,
    })),
  },
];
---

<HubLayout {title} {description} {keywords} {canonicalPath} {schemas}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb items={[
      { label: 'inTV stasera', href: '/' },
      { label: 'Uscite Serie TV & Countdown' },
    ]} />
  </div>

  <!-- HERO SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 dark:bg-rose-900/40 text-rose-700 dark:text-rose-300">
        ⏱️ Calendario Uscite & Countdown Live
      </span>
      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
        Aggiornato in Tempo Reale
      </span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-3">
      Quando Escono le <span class="text-rose-600 dark:text-rose-400">Serie TV</span>: Countdown Uscite
    </h1>

    <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      Non chiederti più <em>«a che ora esce la prossima puntata?»</em>. Consulta le date ufficiali di rilascio in Italia,
      gli orari precisi di pubblicazione e il conto alla rovescia in tempo reale per le serie più attese su Netflix, Prime Video, Disney+, Sky e Apple TV+.
    </p>

    <!-- KPI STATS -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl">
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Serie Monitorate</span>
        <div class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-0.5">{UPCOMING_SERIES.length} Titoli</div>
        <p class="text-[11px] text-slate-500">I franchise più seguiti</p>
      </div>
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Countdown</span>
        <div class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-0.5">Live</div>
        <p class="text-[11px] text-slate-500">Aggiornato al secondo</p>
      </div>
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Orari Ufficiali</span>
        <div class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-0.5">Ora Italiana</div>
        <p class="text-[11px] text-slate-500">Fuso CET / CEST esatto</p>
      </div>
      <div class="bg-white dark:bg-slate-800/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Piattaforme</span>
        <div class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-0.5">Streaming & TV</div>
        <p class="text-[11px] text-slate-500">Netflix, Sky, Prime, Disney+</p>
      </div>
    </div>
  </section>

  <!-- FILTRI & SEARCH -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 mb-6">
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="series-search"
          placeholder="Cerca serie TV... es. Mercoledì, Last of Us, Boys"
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition-all shadow-xs"
        />
      </div>

      <div class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-2">
        <span>In arrivo:</span>
        <strong id="visible-series-count" class="text-slate-900 dark:text-slate-100 font-bold">{UPCOMING_SERIES.length}</strong>
        <span>serie TV</span>
      </div>
    </div>

    <!-- Platform pills -->
    <div class="flex flex-wrap items-center gap-2 pb-2" id="filter-platforms">
      <button
        data-platform="all"
        class="platform-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-rose-600 text-white shadow-xs"
      >
        Tutte le Piattaforme ({UPCOMING_SERIES.length})
      </button>
      <button
        data-platform="Netflix"
        class="platform-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Netflix
      </button>
      <button
        data-platform="Prime Video"
        class="platform-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Prime Video
      </button>
      <button
        data-platform="Disney+"
        class="platform-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Disney+
      </button>
      <button
        data-platform="Sky / NOW"
        class="platform-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Sky / NOW
      </button>
      <button
        data-platform="Apple TV+"
        class="platform-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700"
      >
        Apple TV+
      </button>
    </div>
  </section>

  <!-- SERIES GRID -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="series-grid">
      {UPCOMING_SERIES.map(series => {
        const dateObj = new Date(series.releaseDate);
        const dateStr = dateObj.toLocaleDateString('it-IT', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        });

        return (
          <article
            class="series-card bg-white dark:bg-slate-800/80 rounded-3xl border border-slate-200 dark:border-slate-700/80 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col"
