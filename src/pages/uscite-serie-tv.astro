              </div>

              <!-- Status Badge -->
              <div class="absolute top-3 right-3">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wide bg-rose-600/90 text-white shadow-sm backdrop-blur-xs">
                  {series.status}
