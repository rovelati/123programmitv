                <span class="text-[11px] font-bold text-rose-300 uppercase tracking-wider block mb-0.5">
                  {series.genre}
                </span>
                <h2 class="text-xl font-black text-white leading-tight drop-shadow-sm">
                  {series.title}
                </h2>
                <p class="text-xs text-slate-300 font-medium">
                  Stagione {series.season} · Episodio {series.episode}: <span class="text-white font-semibold">«{series.episodeTitle}»</span>
                </p>
              </div>
            </div>

            <!-- Content & Countdown -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <!-- Live Countdown Box -->
              <div class="mb-4 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-700/80 text-center">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1.5">
                  Tempo Rimanente al Rilascio
                </span>

                <!-- Countdown Units -->
                <div class="countdown-timer flex items-center justify-center gap-2" data-target={series.releaseDate}>
                  <div class="flex flex-col items-center">
                    <span class="days-val font-mono font-black text-xl text-slate-900 dark:text-slate-100">00</span>
                    <span class="text-[9px] uppercase font-bold text-slate-400">Giorni</span>
                  </div>
                  <span class="font-bold text-slate-400 text-sm mb-3">:</span>
                  <div class="flex flex-col items-center">
                    <span class="hours-val font-mono font-black text-xl text-slate-900 dark:text-slate-100">00</span>
                    <span class="text-[9px] uppercase font-bold text-slate-400">Ore</span>
                  </div>
                  <span class="font-bold text-slate-400 text-sm mb-3">:</span>
                  <div class="flex flex-col items-center">
                    <span class="minutes-val font-mono font-black text-xl text-slate-900 dark:text-slate-100">00</span>
                    <span class="text-[9px] uppercase font-bold text-slate-400">Min</span>
                  </div>
                  <span class="font-bold text-slate-400 text-sm mb-3">:</span>
                  <div class="flex flex-col items-center">
                    <span class="seconds-val font-mono font-black text-xl text-rose-600 dark:text-rose-400">00</span>
                    <span class="text-[9px] uppercase font-bold text-slate-400">Sec</span>
                  </div>
                </div>
              </div>

              <!-- Date & Synopsis -->
              <div class="space-y-2 mb-4">
                <div class="flex items-center gap-1.5 text-xs text-slate-700 dark:text-slate-300">
                  <span class="text-rose-500 font-bold">📅</span>
                  <span class="font-semibold capitalize">{dateStr}</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
                  <span class="text-slate-400 font-bold">⏰</span>
                  <span>{series.releaseTimeNote}</span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 pt-1">
                  {series.synopsis}
                </p>
              </div>

              <!-- Footer Actions -->
              <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
                <button
                  type="button"
                  class="share-btn text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 inline-flex items-center gap-1.5 transition-colors"
                  data-share-title={`Countdown uscita ${series.title}`}
                  data-share-url={`https://www.intvstasera.it/uscite-serie-tv/#${series.id}`}
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                  </svg>
                  <span>Condividi</span>
                </button>

                <a
                  href="/serie-stasera/"
                  class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1"
                >
                  <span>Serie in TV stasera</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- GUIDA AGLI ORARI STREAMING -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <div class="bg-gradient-to-br from-slate-50 to-rose-50/30 dark:from-slate-900 dark:to-slate-800/80 rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 mb-2 block">
          Guida Ufficiale agli Orari di Uscita
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
          A che ora escono i nuovi episodi in Italia?
        </h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
          Ogni piattaforma streaming adotta orari di rilascio specifici legati al proprio fuso orario di riferimento:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="font-black text-red-600 text-sm mb-1">Netflix & Disney+</div>
            <div class="text-lg font-black text-slate-900 dark:text-slate-100 mb-1">Ore 09:00</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Orario standard per l'Italia, calcolato sulla mezzanotte della costa Pacifica (PST) statunitense.
            </p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="font-black text-sky-600 text-sm mb-1">Sky & NOW (HBO)</div>
            <div class="text-lg font-black text-slate-900 dark:text-slate-100 mb-1">Ore 03:00</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              In contemporanea notturna con la messa in onda americana della domenica sera su HBO.
            </p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs">
            <div class="font-black text-blue-600 text-sm mb-1">RaiPlay & Mediaset</div>
            <div class="text-lg font-black text-slate-900 dark:text-slate-100 mb-1">Ore 00:01</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Le anteprime digitali delle fiction italiane sbarcano in piattaforma appena scoccata la mezzanotte.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16">
    <div class="border-t border-slate-200 dark:border-slate-800 pt-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-6">
        Domande Frequenti sulle Uscite delle Serie TV
      </h2>

      <div class="space-y-4 max-w-4xl">
        <details class="group bg-white dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-2xs cursor-pointer">
          <summary class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base list-none flex items-center justify-between gap-3">
            <span>Perché alcune serie rilasciano un episodio a settimana e altre tutta la stagione insieme?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Netflix predilige storicamente il modello <em>binge-watching</em> (tutti gli episodi insieme), anche se per i titoli di punta divide sempre più spesso le stagioni in Volume 1 e Volume 2. Disney+, Prime Video, Apple TV+ e Sky adottano invece quasi sempre la cadenza settimanale per alimentare la discussione e l'interesse del pubblico nel tempo.
          </p>
        </details>

        <details class="group bg-white dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-2xs cursor-pointer">
          <summary class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base list-none flex items-center justify-between gap-3">
            <span>Come ricevere un promemoria per il rilascio della puntata?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Puoi aggiungere questa pagina ai tuoi preferiti o cliccare su <em>Condividi</em> per salvare la scheda del conto alla rovescia nelle tue chat o note, così da verificare in qualunque momento i minuti esatti mancanti al rilascio.
          </p>
        </details>
      </div>
    </div>
  </section>
</HubLayout>

<!-- CLIENT SCRIPT: LIVE COUNTDOWN & FILTERS -->
<script is:inline>
  (function() {
    // 1. LIVE COUNTDOWN TICKER
    const timers = document.querySelectorAll('.countdown-timer');

    function updateCountdowns() {
      const now = new Date().getTime();

      timers.forEach(timer => {
        const targetAttr = timer.getAttribute('data-target');
        if (!targetAttr) return;

        const target = new Date(targetAttr).getTime();
        const diff = target - now;

        const daysEl = timer.querySelector('.days-val');
        const hoursEl = timer.querySelector('.hours-val');
        const minsEl = timer.querySelector('.minutes-val');
        const secsEl = timer.querySelector('.seconds-val');

        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '00';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) {
            secsEl.textContent = 'ORA!';
            secsEl.classList.remove('text-rose-600');
            secsEl.classList.add('text-emerald-500');
          }
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
      });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 1000);

    // 2. SEARCH & PLATFORM FILTERS
    const searchInput = document.getElementById('series-search');
    const filterButtons = document.querySelectorAll('.platform-btn');
    const cards = document.querySelectorAll('.series-card');
    const visibleCount = document.getElementById('visible-series-count');

    let currentPlatform = 'all';
    let currentSearch = '';

    function filterCards() {
      let count = 0;
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const original = card.getAttribute('data-original') || '';
        const platform = card.getAttribute('data-platform') || '';

        const matchesPlatform = (currentPlatform === 'all') || (platform === currentPlatform);
        const matchesSearch = !currentSearch ||
          title.includes(currentSearch) ||
          original.includes(currentSearch);

        if (matchesPlatform && matchesSearch) {
          card.style.display = '';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCount) {
        visibleCount.textContent = count;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentSearch = (e.target.value || '').trim().toLowerCase();
        filterCards();
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-rose-600', 'text-white');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });
        this.classList.add('active', 'bg-rose-600', 'text-white');
        this.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');

        currentPlatform = this.getAttribute('data-platform') || 'all';
        filterCards();
      });
    });

    // 3. SHARE BUTTONS
    document.querySelectorAll('.share-btn').forEach(btn => {
      btn.addEventListener('click', async function() {
        const shareUrl = this.getAttribute('data-share-url') || window.location.href;
        const shareTitle = this.getAttribute('data-share-title') || document.title;

        if (navigator.share) {
          try {
            await navigator.share({ title: shareTitle, url: shareUrl });
          } catch(e) {}
        } else {
          navigator.clipboard.writeText(shareUrl).then(() => {
            alert('Link copiato negli appunti!');
          });
        }
      });
    });
  })();
</script>
