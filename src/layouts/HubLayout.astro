---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import type { ChannelGeo } from '../utils/channelGeo';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  keywords?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  schemas?: object[];
  geo?: ChannelGeo | null;
  ogType?: 'website' | 'article' | 'video.movie' | 'video.tv_show';
  articleSection?: string;
  publishedTime?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <!-- Overlay globale programmi — incluso una volta, usa event delegation -->
  <ProgramOverlay />
</BaseLayout>
