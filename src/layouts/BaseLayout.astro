---
import SchemaInjector from '../components/SchemaInjector.astro';
import '../styles/global.css';
import { absoluteUrl } from '../utils/urls';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Parole chiave SEO (opzionale) */
  keywords?: string;
  /** Percorso relativo o URL assoluto dell'immagine OG. Default: /og/default.png */
  ogImage?: string;
  /** Alt text per og:image. Default: titolo della pagina */
  ogImageAlt?: string;
  /** Larghezza immagine OG in pixel. Default: 1200 */
  ogImageWidth?: number;
  /** Altezza immagine OG in pixel. Default: 630 */
  ogImageHeight?: number;
  noindex?: boolean;
  schemas?: object[];
  /**
   * Tipo OG:
   * - 'website'       → pagine hub, home, categorie
   * - 'article'       → schede programma (noindex=false)
   * - 'video.movie'   → film indicizzabili
   * - 'video.tv_show' → serie/fiction indicizzabili
   */
  ogType?: 'website' | 'article' | 'video.movie' | 'video.tv_show';
  /** Per ogType='article': sezione editoriale (es. "Film", "Sport") */
  articleSection?: string;
  /** Per ogType='article': data pubblicazione ISO (default: ora del build) */
  publishedTime?: string;
}

const {
  title,
  description,
  canonicalPath,
  keywords,
  ogImage      = '/og/default.png',
  ogImageAlt,
  ogImageWidth  = 1200,
  ogImageHeight = 630,
  noindex       = false,
  schemas       = [],
  ogType        = 'website',
  articleSection,
  publishedTime,
} = Astro.props;

const SITE_URL    = 'https://www.intvstasera.it';
const canonicalUrl = absoluteUrl(canonicalPath);
const ogImageUrl   = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
const imageAlt     = ogImageAlt ?? title;

// Tipo MIME inferito dall'estensione (per og:image:type)
const ext          = ogImageUrl.split('.').pop()?.toLowerCase() ?? 'png';
const MIME: Record<string, string> = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', svg: 'image/svg+xml' };
const ogImageType  = MIME[ext] ?? 'image/jpeg';

// Ora del build — usata per og:updated_time e article:modified_time
const nowISO       = new Date().toISOString();
const pubTime      = publishedTime ?? nowISO;

const isArticle    = ogType === 'article' || ogType === 'video.movie' || ogType === 'video.tv_show';
const isVideo      = ogType === 'video.movie' || ogType === 'video.tv_show';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

    <!-- Anti-FOUC: applica .dark PRIMA del render — nessun flash -->
    <!-- data-cfasync="false": esclude da Cloudflare Rocket Loader (deve girare sincrono) -->
    <script is:inline data-cfasync="false">
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (stored === null && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch(e) {}
      })();
    </script>

    <!-- ═══ SEO ═══════════════════════════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Redazione inTV stasera" />
    <meta name="publisher" content="inTVstasera.it" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }
    <link rel="canonical" href={canonicalUrl} />

    <!-- ═══ Open Graph ════════════════════════════════════════════════════ -->
    <!-- Tipo e URL -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:site_name"   content="inTVstasera.it" />
    <meta property="og:locale"      content="it_IT" />

    <!-- Titolo e descrizione -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />

    <!-- Immagine — larghezza/altezza/tipo/alt sono richiesti da Facebook e suggeriti da Google -->
    <meta property="og:image"        content={ogImageUrl} />
    <meta property="og:image:url"    content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type"   content={ogImageType} />
    <meta property="og:image:width"  content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt"    content={imageAlt} />

    <!-- Freshness — importante per contenuti aggiornati quotidianamente -->
    <meta property="og:updated_time" content={nowISO} />

    <!-- Article / Video metadata (pubblicato quando ogType ≠ 'website') -->
    {isArticle && (
      <>
        <meta property="article:published_time"  content={pubTime} />
        <meta property="article:modified_time"   content={nowISO} />
        {articleSection && <meta property="article:section" content={articleSection} />}
        <meta property="article:author"          content={`${SITE_URL}/#organization`} />
        <meta property="article:publisher"       content={SITE_URL} />
      </>
    )}

    <!-- Video OG (per video.movie / video.tv_show) -->
    {isVideo && (
      <>
        <meta property="video:release_date" content={pubTime} />
      </>
    )}

    <!-- ═══ Twitter / X Card ══════════════════════════════════════════════ -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />
    <meta name="twitter:image:alt"   content={imageAlt} />

    <!-- ═══ Fonts ════════════════════════════════════════════════════════ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />

    <!-- ═══ Favicon & Web App ════════════════════════════════════════════ -->
    <!-- ICO multi-size per browser legacy -->
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <!-- PNG per browser moderni -->
    <link rel="icon" type="image/png" href="/favicon/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <!-- Apple Touch Icon (iOS home screen) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <!-- Web App Manifest (Android / PWA / Edge) -->
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Microsoft Windows & Edge Integration -->
    <meta name="application-name" content="In TV Stasera" />
    <meta name="msapplication-TileColor" content="#2563eb" />
    <meta name="msapplication-TileImage" content="/web-app-manifest-192x192.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-tooltip" content="Guida TV Italiana Stasera e Ora" />
    <meta name="msapplication-starturl" content="/" />

    <!-- ═══ JSON-LD Structured Data ═══════════════════════════════════════ -->
    {schemas.length > 0 && <SchemaInjector {schemas} />}

    <!-- ═══ Google Analytics 4 ════════════════════════════════════════════ -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-824117SV8J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-824117SV8J', { anonymize_ip: true });
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans antialiased">
    <slot />
  </body>
</html>
