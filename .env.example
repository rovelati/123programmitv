# Postgres locale (Contabo VPS) — server-only, mai esposta al browser
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/programmitv

# Sito
SITE_URL=https://www.intvstasera.it
SEARCH_CONSOLE_PUBLIC_DIR=/var/www/123programmitv.it/astro/public/search-console

# Cloudflare Pages (deploy da rebuild-and-deploy-vps.sh)
CF_API_KEY=
CF_API_EMAIL=
CF_ACCOUNT_ID=

# Google Indexing API (service account — Proprietario in GSC su www.intvstasera.it)
# GOOGLE_SA_KEY_JSON={"type":"service_account",...}
GOOGLE_SA_KEY_FILE=/var/www/123programmitv.it/secrets/google-sa.json
